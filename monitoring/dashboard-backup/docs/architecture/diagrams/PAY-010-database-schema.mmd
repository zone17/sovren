%% Idempotency System - Database Schema
%% Story: PAY-010
%% Date: 2025-10-25

erDiagram
    idempotency_cache {
        UUID idempotency_key PK "Client-provided UUID v4"
        VARCHAR request_hash "SHA-256 hash of request body"
        VARCHAR http_method "POST, PUT, PATCH, DELETE"
        VARCHAR endpoint_path "API endpoint path"
        INTEGER response_status "HTTP status code (200-599)"
        JSONB response_body "Cached JSON response"
        JSONB response_headers "Cached response headers"
        TIMESTAMP created_at "Entry creation timestamp"
        TIMESTAMP expires_at "Expiration timestamp (created_at + 24h)"
        VARCHAR client_ip "Client IP address (optional)"
        TEXT user_agent "Client user agent (optional)"
    }

    %% Table annotations
    idempotency_cache ||--o{ "Indexes" : has
    idempotency_cache ||--o{ "Constraints" : enforces

    %% Index details (shown as relationship)
    Indexes {
        INDEX idx_idempotency_cache_expires_at "On expires_at"
        INDEX idx_idempotency_cache_endpoint "On endpoint_path, http_method"
        INDEX idx_idempotency_cache_created_at "On created_at DESC"
        INDEX idx_idempotency_cache_cleanup "On expires_at, created_at"
    }

    %% Constraint details
    Constraints {
        CHECK valid_response_status "response_status BETWEEN 100 AND 599"
        CHECK valid_http_method "http_method IN (POST, PUT, PATCH, DELETE)"
        CHECK valid_expiry "expires_at > created_at"
    }
