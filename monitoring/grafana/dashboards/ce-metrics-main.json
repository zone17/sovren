{
  "uid": "ce-metrics-main",
  "title": "CE Metrics Dashboard",
  "schemaVersion": 39,
  "graphTooltip": 1,
  "refresh": "30s",
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Project-Level KPIs",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Total Cost",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "sum(last_over_time(ce_session_cost_usd{project=~\"$project\", pr_number=~\"$pr\"}[$__range]))",
          "legendFormat": "Total Cost",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "PRs Merged",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "count(last_over_time(ce_pr_merged_total{project=~\"$project\"}[$__range]))",
          "legendFormat": "PRs Merged",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Avg Time-to-Merge",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3600 },
              { "color": "red", "value": 14400 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "avg(last_over_time(ce_phase_duration_seconds{phase=~\"$phase\", pr_number=~\"$pr\"}[$__range]))",
          "legendFormat": "Avg Time-to-Merge",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "P1 Count",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "sum(last_over_time(ce_findings_total{severity=\"P1\", pr_number=~\"$pr\"}[$__range]))",
          "legendFormat": "P1 Findings",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 2,
      "panels": [],
      "title": "Cost Efficiency",
      "type": "row"
    },
    {
      "id": 20,
      "title": "Cost per PR",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 200,
        "fillOpacity": 80,
        "gradientMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pr_number) (last_over_time(ce_session_cost_usd{project=~\"$project\", pr_number=~\"$pr\"}[$__range]))",
          "legendFormat": "{{pr_number}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "title": "Cost by CE Phase",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "plan" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#1F60C4", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "work" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#37872D", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "review" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#FF780A", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "compound" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#8F3BB8", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "adhoc" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#808080", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (phase) (last_over_time(ce_session_cost_usd{project=~\"$project\", phase=~\"$phase\"}[$__range]))",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 22,
      "title": "Cost by Model",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "opus" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#FFD700", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "sonnet" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#C0C0C0", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "haiku" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#CD7F32", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (model) (last_over_time(ce_session_cost_usd{project=~\"$project\", model=~\"$model\"}[$__range]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 3,
      "panels": [],
      "title": "Velocity",
      "type": "row"
    },
    {
      "id": 30,
      "title": "Time-to-Merge Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        }
      },
      "targets": [
        {
          "expr": "last_over_time(ce_phase_duration_seconds{phase=~\"$phase\", pr_number=~\"$pr\"}[$__range])",
          "legendFormat": "{{pr_number}} - {{phase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 31,
      "title": "Phase Duration Breakdown",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "orientation": "auto",
        "stacking": "normal",
        "xTickLabelRotation": 0,
        "fillOpacity": 80,
        "gradientMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "plan" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#1F60C4", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "work" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#37872D", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "review" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#FF780A", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "compound" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#8F3BB8", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "adhoc" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#808080", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (phase) (last_over_time(ce_phase_duration_seconds{pr_number=~\"$pr\"}[$__range]))",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 32,
      "title": "Review Rounds per PR",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "orientation": "auto",
        "xTickLabelRotation": 0,
        "fillOpacity": 80,
        "gradientMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "last_over_time(ce_review_rounds_total{pr_number=~\"$pr\"}[$__range])",
          "legendFormat": "PR {{pr_number}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 4,
      "panels": [],
      "title": "Quality",
      "type": "row"
    },
    {
      "id": 40,
      "title": "Findings by Severity",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "orientation": "auto",
        "stacking": "normal",
        "xTickLabelRotation": 0,
        "fillOpacity": 80,
        "gradientMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "P1" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#E02F44", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "P2" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#FF780A", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "P3" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#FADE2A", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (severity, pr_number) (last_over_time(ce_findings_total{pr_number=~\"$pr\"}[$__range]))",
          "legendFormat": "{{severity}} - PR {{pr_number}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 41,
      "title": "P1 Rate Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto"
          }
        }
      },
      "targets": [
        {
          "expr": "last_over_time(ce_findings_total{severity=\"P1\", pr_number=~\"$pr\"}[$__range])",
          "legendFormat": "PR {{pr_number}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 42,
      "title": "Finding Rate per 1K LOC",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        }
      },
      "targets": [
        {
          "expr": "sum(last_over_time(ce_findings_total{pr_number=~\"$pr\"}[$__range]))",
          "legendFormat": "Findings (LOC metric pending)",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 5,
      "panels": [],
      "title": "Knowledge & Agents",
      "type": "row"
    },
    {
      "id": 50,
      "title": "Stale Todo Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.6 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "sum(last_over_time(ce_stale_todo_total{pr_number=~\"$pr\"}[$__range])) / (sum(last_over_time(ce_findings_total{pr_number=~\"$pr\"}[$__range])) > 0 or vector(1))",
          "legendFormat": "Stale Todo Rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 51,
      "title": "Agent Respawn Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.3 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "sum(last_over_time(ce_agent_respawn_total{}[$__range])) / (sum(last_over_time(ce_agent_spawn_total{}[$__range])) > 0 or vector(1))",
          "legendFormat": "Respawn Rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 52,
      "title": "Merge Conflict Streak",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "green", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "max(last_over_time(ce_merge_conflict_total{}[$__range]))",
          "legendFormat": "Conflict-Free Sprints",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 6,
      "panels": [],
      "title": "Active Session",
      "type": "row"
    },
    {
      "id": 60,
      "title": "Current Session Cost",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [
        {
          "expr": "sum(ce_session_cost_usd{project=~\"$project\"})",
          "legendFormat": "Session Cost",
          "refId": "A"
        }
      ]
    },
    {
      "id": 61,
      "title": "Current Phase",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "1": { "text": "plan", "index": 0 } } },
            { "type": "value", "options": { "2": { "text": "work", "index": 1 } } },
            { "type": "value", "options": { "3": { "text": "review", "index": 2 } } },
            { "type": "value", "options": { "4": { "text": "compound", "index": 3 } } },
            { "type": "value", "options": { "5": { "text": "adhoc", "index": 4 } } }
          ]
        }
      },
