    {
      "id": 303,
      "title": "Avg Agent Duration",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "-- Default --" },
      "options": {
        "reduceOptions": { "calcs": ["mean"] },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
