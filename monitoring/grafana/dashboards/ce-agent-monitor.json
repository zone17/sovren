        "justifyMode": "auto"
      }
    },
    {
      "id": 43,
      "title": "Cache Creation Tokens",
      "description": "Tokens written to cache — investment for future reads",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "ce-prometheus" },
      "targets": [
        {
          "expr": "ce_session_tokens_total{type=\"cache_creation\",session=~\"$session\",phase=~\"$phase\",project=~\"$project\"}",
