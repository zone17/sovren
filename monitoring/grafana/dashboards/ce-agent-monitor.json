    {
      "id": 42,
      "title": "Cache Read Tokens",
      "description": "Tokens served from cache — higher is better for cost",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "ce-prometheus" },
      "targets": [
        {
          "expr": "ce_session_tokens_total{type=\"cache_read\",session=~\"$session\",phase=~\"$phase\",project=~\"$project\"}",
          "legendFormat": "{{session}}",
