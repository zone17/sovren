        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 41,
      "title": "Output Tokens",
      "description": "Total output tokens generated",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "ce-prometheus" },
      "targets": [
        {
          "expr": "ce_session_tokens_total{type=\"output\",session=~\"$session\",phase=~\"$phase\",project=~\"$project\"}",
          "legendFormat": "{{session}}",
