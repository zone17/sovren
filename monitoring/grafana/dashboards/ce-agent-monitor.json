      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 44,
      "title": "Token Breakdown by Type",
      "description": "Visual comparison of token types per session",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "ce-prometheus" },
      "targets": [
        {
          "expr": "ce_session_tokens_total{session=~\"$session\",phase=~\"$phase\",project=~\"$project\"}",
          "legendFormat": "{{type}} ({{session}})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 80,
            "axisLabel": "Tokens"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^input" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^output" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^cache_read" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^cache_creation" },
