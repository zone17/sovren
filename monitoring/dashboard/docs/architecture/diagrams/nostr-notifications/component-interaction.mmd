graph TD
    subgraph "NotificationCenter Component"
        NC_Header[Header with Badge]
        NC_Filters[Filter Tabs]
        NC_List[Notification List]
        NC_Actions[Action Buttons]
        NC_Settings[Settings Panel]
    end

    subgraph "NotificationItem Component"
        NI_Avatar[Author Avatar]
        NI_Content[Content Text]
        NI_Meta[Timestamp & Actions]
        NI_Badge[Unread Indicator]
    end

    subgraph "NotificationBadge Component"
        Badge_Count[Unread Count]
        Badge_Dot[Indicator Dot]
    end

    subgraph "NotificationSettings Component"
        Settings_Types[Enable/Disable Types]
        Settings_Sound[Sound Preferences]
        Settings_Desktop[Desktop Notifications]
    end

    subgraph "NotificationEmpty Component"
        Empty_Icon[Empty State Icon]
        Empty_Message[Message]
        Empty_CTA[Call to Action]
    end

    NC_Header --> Badge_Count
    NC_List --> NI_Avatar
    NC_List --> NI_Content
    NC_List --> NI_Meta
    NC_List --> NI_Badge
    NC_Actions --> Settings_Types
    NC_Settings --> Settings_Sound
    NC_Settings --> Settings_Desktop

    NI_Content --> Empty_Icon
    NI_Meta -.->|If no notifications| Empty_Message

    style NC_Header fill:#4a90e2
    style NI_Avatar fill:#e27d4a
    style Badge_Count fill:#e74c3c
    style Settings_Types fill:#9b59b6
