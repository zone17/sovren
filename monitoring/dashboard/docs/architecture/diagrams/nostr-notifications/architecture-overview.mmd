graph TB
    subgraph "User Interface Layer"
        NC[NotificationCenter]
        NI[NotificationItem]
        NB[NotificationBadge]
        NS[NotificationSettings]
        NE[NotificationEmpty]
    end

    subgraph "Hook Layer"
        HN[useNotifications]
        HU[useUnreadCount]
        HS[useNotificationSound]
    end

    subgraph "Service Layer"
        NService[NotificationService]
        SM[SubscriptionManager]
        PM[ProfileManager]
        EC[EventCache]
        N04[NIP04Service]
    end

    subgraph "Storage Layer"
        IDB[(IndexedDB)]
        LS[LocalStorage<br/>Preferences]
    end

    subgraph "External Systems"
        NR[NOSTR Relays]
        Desktop[Desktop Notifications API]
        Audio[Web Audio API]
    end

    NC --> HN
    NC --> HU
    NC --> HS
    NB --> HU

    HN --> NService
    HU --> NService
    HS --> Audio

    NService --> SM
    NService --> PM
    NService --> EC
    NService --> N04
    NService --> IDB
    NService --> LS

    SM --> NR
    EC --> IDB
    PM --> NR

    NService --> Desktop

    style NC fill:#4a90e2
    style NService fill:#e27d4a
    style SM fill:#9b59b6
    style IDB fill:#2ecc71
