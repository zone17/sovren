# Sovren Development Environment Configuration
# This file contains development-specific defaults
# Copy to .env and customize as needed

# ===========================================
# CORE APPLICATION SETTINGS
# ===========================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================
# Get these values from your Supabase project dashboard
# https://app.supabase.com/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# Generate secure secrets for development
# Use: openssl rand -hex 32

JWT_SECRET=dev-jwt-secret-change-this-to-at-least-32-characters-long
JWT_EXPIRES_IN=7d
SESSION_SECRET=dev-session-secret-change-this-to-at-least-32-characters-long

# ===========================================
# LIGHTNING NETWORK CONFIGURATION (REQUIRED)
# ===========================================
# For development, use testnet and LNbits demo instance
# Get free testnet instance at: https://legend.lnbits.com

LNBITS_API_URL=https://legend.lnbits.com
LNBITS_ADMIN_KEY=your-lnbits-admin-key
LNBITS_INVOICE_READ_KEY=your-lnbits-invoice-read-key
LNBITS_WEBHOOK_SECRET=dev-webhook-secret-change-this

LIGHTNING_NETWORK=testnet
LIGHTNING_MIN_AMOUNT=1000
LIGHTNING_MAX_AMOUNT=100000000

# ===========================================
# NOSTR PROTOCOL CONFIGURATION (REQUIRED)
# ===========================================
# Development NOSTR relays - free public relays
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social

# Optional: Generate at https://nostrtool.com/
NOSTR_PRIVATE_KEY=
NOSTR_PUBLIC_KEY=

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Development Redis (Docker or local)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ===========================================
# EMAIL CONFIGURATION (OPTIONAL FOR DEV)
# ===========================================
# For development, emails will be caught by Mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=dev@sovren.local

EMAIL_FROM_NAME=Sovren Platform (Dev)
EMAIL_SUPPORT=support@sovren.local

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================
# Development file storage - local uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Optional: IPFS for testing
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
PINATA_JWT_TOKEN=

# Optional: Arweave for testing
ARWEAVE_GATEWAY_URL=https://arweave.net

# ===========================================
# AI & ANALYTICS CONFIGURATION
# ===========================================
# Optional: Add your OpenAI API key for AI features
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

ANALYTICS_ENABLED=true
ANALYTICS_SAMPLING_RATE=1.0

# ===========================================
# MONITORING & OBSERVABILITY
# ===========================================
# Optional: Sentry for error tracking in development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Grafana (Docker)
GRAFANA_PASSWORD=admin

# Prometheus
PROMETHEUS_ENABLED=false

# ===========================================
# RATE LIMITING
# ===========================================
# Relaxed rate limits for development
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

LIGHTNING_RATE_LIMIT_WINDOW_MS=60000
LIGHTNING_RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# FEATURE FLAGS
# ===========================================
# Enable all features in development
FEATURE_LIGHTNING_PAYMENTS=true
FEATURE_AI_CONTENT_GENERATION=true
FEATURE_NOSTR_PUBLISHING=true
FEATURE_CONTENT_MONETIZATION=true
FEATURE_PREMIUM_SUBSCRIPTIONS=true

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Development-specific settings
DEBUG_ENABLED=true
DEBUG_NAMESPACE=sovren:*

HOT_RELOAD=true
WATCH_FILES=true

# Test database (optional)
TEST_DATABASE_URL=postgresql://sovren:test_password@localhost:5432/sovren_test
TEST_REDIS_URL=redis://localhost:6380

# ===========================================
# CORS & SECURITY
# ===========================================
# Development CORS settings
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SECURE_COOKIES=false
HELMET_ENABLED=false

# ===========================================
# DOCKER SPECIFIC SETTINGS
# ===========================================
CONTAINER_MEMORY_LIMIT=512m
CONTAINER_CPU_LIMIT=0.5
