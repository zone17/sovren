%% System Architecture Overview - Epic 005 Backend Service Refactoring
%% Version: 1.0.0
%% Date: 2025-10-27
%% Description: Complete system architecture showing all 29 services organized by domain

graph TB
    subgraph "Client Layer"
        WebApp[Web Application<br/>React + TypeScript]
        MobileApp[Mobile App<br/>Progressive Web App]
    end

    subgraph "API Gateway Layer"
        APIGateway[API Gateway<br/>Express.js]
        AuthMiddleware[Auth Middleware<br/>JWT + NOSTR]
        RateLimiter[Rate Limiter]
    end

    subgraph "Core Infrastructure Services"
        ServiceContainer[Service Container<br/>Dependency Injection]
        ServiceFactory[Service Factory<br/>Service Creation]
        EventBus[Event Bus Service<br/>Pub/Sub Pattern]
        RepositoryFactory[Repository Factory<br/>Data Access]
        MigrationService[Migration Service<br/>Schema Evolution]
        DependencyAnalyzer[Dependency Analyzer<br/>Graph Analysis]
    end

    subgraph "Shared Services Domain"
        EmailService[Email Service<br/>Transactional Emails]
        NotificationService[Notification Service<br/>Multi-Channel]
        AuditLogService[Audit Log Service<br/>Compliance Tracking]
        CacheService[Cache Service<br/>Redis + Multi-Layer]
    end

    subgraph "Content Services Domain"
        ContentPublishing[Content Publishing Service<br/>NOSTR Integration]
        ContentModeration[Content Moderation Service<br/>AI + Manual Review]
        ContentSearch[Content Search Service<br/>Full-Text Search]
        ContentRecommendation[Content Recommendation Service<br/>AI-Powered]
        ContentAnalytics[Content Analytics Service<br/>Performance Metrics]
        ContentVersioning[Content Versioning Service<br/>Version Control]
    end

    subgraph "User Services Domain"
        UserProfile[User Profile Service<br/>Identity Management]
        UserPreferences[User Preferences Service<br/>Settings Management]
        UserActivity[User Activity Service<br/>Behavior Tracking]
        UserRelationship[User Relationship Service<br/>Social Graph]
        UserAnalytics[User Analytics Service<br/>Engagement Metrics]
    end

    subgraph "Payment Services Domain"
        PaymentProcessing[Payment Processing Service<br/>Lightning Network]
        CurrencyService[Currency Service<br/>Exchange Rates]
        SubscriptionService[Subscription Service<br/>Recurring Billing]
        RefundService[Refund Service<br/>Payment Reversal]
        PaymentAnalytics[Payment Analytics Service<br/>Revenue Metrics]
        WebhookService[Webhook Service<br/>Event Delivery]
    end

    subgraph "External Systems"
        NostrRelays[NOSTR Relays<br/>Distributed Network]
        LightningNode[Lightning Node<br/>Bitcoin Payments]
        EmailProvider[Email Provider<br/>SMTP/API]
        ExchangeAPIs[Exchange APIs<br/>Currency Data]
        SearchEngine[Search Engine<br/>Elasticsearch]
    end

    subgraph "Data Layer"
        PostgreSQL[(PostgreSQL<br/>Primary Database)]
        Redis[(Redis<br/>Cache + Queue)]
        S3[S3-Compatible Storage<br/>Media Files]
    end

    %% Client to API Gateway
    WebApp --> APIGateway
    MobileApp --> APIGateway

    %% API Gateway to Middleware
    APIGateway --> AuthMiddleware
    APIGateway --> RateLimiter

    %% API Gateway to Core Infrastructure
    APIGateway --> ServiceContainer
    ServiceContainer --> ServiceFactory
    ServiceContainer --> EventBus
    ServiceContainer --> RepositoryFactory

    %% Core Infrastructure Dependencies
    ServiceFactory --> DependencyAnalyzer
    MigrationService --> PostgreSQL

    %% Shared Services Dependencies
    EventBus --> NotificationService
    EventBus --> AuditLogService
    NotificationService --> EmailService
    EmailService --> EmailProvider
    CacheService --> Redis

    %% Content Services Dependencies
    ServiceContainer --> ContentPublishing
    ServiceContainer --> ContentModeration
    ServiceContainer --> ContentSearch
    ServiceContainer --> ContentRecommendation
    ServiceContainer --> ContentAnalytics
    ServiceContainer --> ContentVersioning

    ContentPublishing --> NostrRelays
    ContentPublishing --> EventBus
    ContentSearch --> SearchEngine
    ContentRecommendation --> ContentAnalytics
    ContentVersioning --> S3

    %% User Services Dependencies
    ServiceContainer --> UserProfile
    ServiceContainer --> UserPreferences
    ServiceContainer --> UserActivity
    ServiceContainer --> UserRelationship
    ServiceContainer --> UserAnalytics

    UserProfile --> NostrRelays
    UserActivity --> EventBus
    UserRelationship --> CacheService

    %% Payment Services Dependencies
    ServiceContainer --> PaymentProcessing
    ServiceContainer --> CurrencyService
    ServiceContainer --> SubscriptionService
    ServiceContainer --> RefundService
    ServiceContainer --> PaymentAnalytics
    ServiceContainer --> WebhookService

    PaymentProcessing --> LightningNode
    PaymentProcessing --> EventBus
    CurrencyService --> ExchangeAPIs
    SubscriptionService --> PaymentProcessing
    RefundService --> PaymentProcessing
    WebhookService --> EventBus

    %% All Services to Repository Factory
    ContentPublishing --> RepositoryFactory
    ContentModeration --> RepositoryFactory
    ContentSearch --> RepositoryFactory
    ContentRecommendation --> RepositoryFactory
    ContentAnalytics --> RepositoryFactory
    ContentVersioning --> RepositoryFactory
    UserProfile --> RepositoryFactory
    UserPreferences --> RepositoryFactory
    UserActivity --> RepositoryFactory
    UserRelationship --> RepositoryFactory
    UserAnalytics --> RepositoryFactory
    PaymentProcessing --> RepositoryFactory
    SubscriptionService --> RepositoryFactory
    RefundService --> RepositoryFactory
    PaymentAnalytics --> RepositoryFactory

    %% Repository Factory to Database
    RepositoryFactory --> PostgreSQL

