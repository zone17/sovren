    style CurrencyService fill:#ff9800,stroke:#e65100,stroke-width:2px,color:#fff
    style LightningNode fill:#fff9c4,stroke:#f57f17,stroke-width:3px
    style LightningNetwork fill:#fffde7,stroke:#f9a825,stroke-width:2px
    style WebhookService fill:#ff5722,stroke:#bf360c,stroke-width:2px,color:#fff
    style Repository fill:#9e9e9e,stroke:#616161,stroke-width:2px,color:#fff
    style DB fill:#4caf50,stroke:#2e7d32,stroke-width:3px,color:#fff
    style EventBus fill:#9e9e9e,stroke:#616161,stroke-width:3px,color:#fff
    style Cache fill:#f44336,stroke:#c62828,stroke-width:2px,color:#fff
    style PaymentAnalytics fill:#ff9800,stroke:#e65100,stroke-width:2px,color:#fff
