%% Secrets Management System - Architecture Overview
%% User Story: US-005
%% Description: High-level architecture showing components and data flow

graph TB
    subgraph "Application Layer"
        App[Application Code]
        Bootstrap[Bootstrap Process]
        Controllers[API Controllers]
    end

    subgraph "Secrets Service Layer"
        SS[SecretsService]
        Cache[In-Memory Cache<br/>TTL: 1 hour]
        Config[SecretsConfig]
    end

    subgraph "Secret Sources"
        AWS[AWS Secrets Manager<br/>Production/Staging]
        ENV[.env File<br/>Development]
    end

    subgraph "AWS Infrastructure"
        IAM[IAM Roles/Policies]
        SM[Secrets Manager]
        CT[CloudTrail Audit]
    end

    %% Application to Service
    App --> SS
    Bootstrap --> SS
    Controllers --> SS

    %% Service Internal Flow
    SS --> Cache
    SS --> Config
    Config -.provides mapping.-> SS

    %% Service to Sources
    SS -->|useAwsSecrets=true| AWS
    SS -->|useAwsSecrets=false| ENV

    %% AWS Infrastructure
    AWS --> IAM
    AWS --> SM
    SM --> CT

    %% Cache Flow
    Cache -.cache hit.-> SS
    AWS -.cache miss.-> Cache
    ENV -.cache miss.-> Cache

    %% Styling
    classDef app fill:#e1f5ff,stroke:#01579b
    classDef service fill:#f3e5f5,stroke:#4a148c
    classDef source fill:#fff3e0,stroke:#e65100
    classDef aws fill:#232f3e,stroke:#ff9900,color:#fff

    class App,Bootstrap,Controllers app
    class SS,Cache,Config service
    class AWS,ENV source
    class IAM,SM,CT aws
