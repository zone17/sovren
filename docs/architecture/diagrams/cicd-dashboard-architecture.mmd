    classDef external fill:#f59e0b,stroke:#d97706,color:#fff
    classDef storage fill:#8b5cf6,stroke:#7c3aed,color:#fff

    class UI,StatusPanel,HealthMonitor,SmokeTests,Metrics,ErrorPanel,RollbackUI,Timeline frontend
    class GHService,HealthService,MetricsService,RealtimeService,DeploymentHook,HealthHook,SmokeHook,MetricsHook,RealtimeHook service
    class API,DeployAPI,HealthAPI,SmokeAPI,MetricsAPI,GHAPI,WSEndpoint,DeployController,HealthController,SmokeController,MetricsController,GHController,DeployService,HealthServiceBE,SmokeServiceBE,MetricsServiceBE,OctokitClient,WSServer,SSEServer,WebhookHandler backend
    class GitHubAPI,StagingHealth,ProdHealth external
    class Redis,DB storage
