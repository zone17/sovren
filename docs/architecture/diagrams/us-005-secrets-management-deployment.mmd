%% Secrets Management System - Deployment Process
%% User Story: US-005
%% Description: Migration and deployment workflow

graph TB
    subgraph "Pre-Migration"
        ENV_FILE[.env Files<br/>❌ Insecure]
        CODE[Hardcoded Secrets<br/>❌ Security Risk]
    end

    subgraph "Migration Phase"
        AUDIT[Audit Current Secrets]
        AWS_SETUP[Setup AWS IAM & Policies]
        CREATE_SECRETS[Create Secrets in AWS]
        UPDATE_CODE[Integrate SecretsService]
        STAGING[Deploy to Staging]
    end

    subgraph "Production Deployment"
        BLUE[Current Production<br/>Blue Environment]
        GREEN[New Version<br/>Green Environment<br/>AWS Secrets]
        TRAFFIC[Traffic Router]
    end

    subgraph "Post-Migration"
        MONITOR[Monitor Performance]
        VALIDATE[Validate All Secrets]
        CLEANUP[Remove .env Files]
        ROTATE[Setup Rotation Schedule]
    end

    subgraph "AWS Infrastructure"
        SM[Secrets Manager<br/>🔐 Encrypted Storage]
        IAM_ROLE[IAM Roles<br/>🔑 Access Control]
        CT[CloudTrail<br/>📊 Audit Logs]
    end

    %% Migration Flow
    ENV_FILE --> AUDIT
    CODE --> AUDIT
    AUDIT --> AWS_SETUP
    AWS_SETUP --> CREATE_SECRETS
    CREATE_SECRETS --> UPDATE_CODE
    UPDATE_CODE --> STAGING

    %% Deployment Flow
    STAGING -->|Tests Pass| GREEN
    BLUE --> TRAFFIC
    GREEN --> TRAFFIC

    %% Traffic Shift
    TRAFFIC -->|10% Traffic| GREEN
    TRAFFIC -->|Monitor 15min| GREEN
    TRAFFIC -->|50% Traffic| GREEN
    TRAFFIC -->|Monitor 15min| GREEN
    TRAFFIC -->|100% Traffic| GREEN

    %% Post-Deployment
    GREEN --> MONITOR
    MONITOR --> VALIDATE
    VALIDATE --> CLEANUP
    CLEANUP --> ROTATE

    %% AWS Integration
    GREEN -.reads from.-> SM
    SM --- IAM_ROLE
    SM --- CT

    %% Rollback Path
    GREEN -.rollback if issues.-> BLUE

    %% Styling
    classDef deprecated fill:#ffcdd2,stroke:#c62828
    classDef migration fill:#fff9c4,stroke:#f57f17
    classDef deployment fill:#c8e6c9,stroke:#2e7d32
    classDef aws fill:#232f3e,stroke:#ff9900,color:#fff
    classDef success fill:#a5d6a7,stroke:#1b5e20

    class ENV_FILE,CODE deprecated
    class AUDIT,AWS_SETUP,CREATE_SECRETS,UPDATE_CODE,STAGING migration
    class BLUE,GREEN,TRAFFIC deployment
    class SM,IAM_ROLE,CT aws
    class MONITOR,VALIDATE,CLEANUP,ROTATE success
