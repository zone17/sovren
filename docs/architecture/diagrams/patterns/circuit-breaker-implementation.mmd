%% Circuit Breaker Implementation - Webhook Service Example
%% Version: 1.0.0
%% Date: 2025-10-27
%% Description: Complete circuit breaker implementation for webhook delivery

graph TB
    subgraph "Circuit Breaker Components"
        CircuitBreaker[Circuit Breaker<br/>State Machine]
        StateManager[State Manager<br/>Transition Logic]
        FailureCounter[Failure Counter<br/>Sliding Window]
        HealthChecker[Health Checker<br/>Test Requests]
    end

    subgraph "Configuration"
        Config["Circuit Breaker Config:<br/>---<br/>failureThreshold: 5<br/>failureWindow: 60s<br/>openTimeout: 30s<br/>halfOpenMaxRequests: 3<br/>successThreshold: 2<br/>timeoutDuration: 5s"]
    end

    subgraph "Client Service"
        WebhookService[Webhook Service<br/>Caller]
        FallbackHandler[Fallback Handler<br/>Cached Response]
        RetryQueue[Retry Queue<br/>Failed Requests]
    end

    subgraph "Protected Service"
        ExternalWebhook[External Webhook Endpoint<br/>Third-party API]
        ServiceMonitor[Service Monitor<br/>Health Status]
    end

    subgraph "States & Metrics"
        ClosedState[CLOSED<br/>---<br/>Requests: 1000<br/>Failures: 2<br/>Success Rate: 99.8%]

        OpenState[OPEN<br/>---<br/>Blocked: 500<br/>Duration: 30s<br/>Fallback Used: 500]

        HalfOpenState[HALF-OPEN<br/>---<br/>Test Requests: 3<br/>Successes: 2<br/>Testing: true]
    end

    subgraph "Monitoring & Alerting"
        MetricsCollector[Metrics Collector<br/>Prometheus]
        AlertManager[Alert Manager<br/>Circuit Open Alert]
        Dashboard[Monitoring Dashboard<br/>Real-time Status]
    end

    %% Normal Flow (CLOSED)
    WebhookService -->|1. Request| CircuitBreaker
    CircuitBreaker -->|2. Check State| StateManager
    StateManager -->|3. CLOSED - Allow| CircuitBreaker
    CircuitBreaker -->|4. Execute| ExternalWebhook

    ExternalWebhook -->|5a. Success| CircuitBreaker
    CircuitBreaker -->|6. Reset Counter| FailureCounter
    CircuitBreaker -->|7. Return Success| WebhookService

    ExternalWebhook -->|5b. Failure| CircuitBreaker
    CircuitBreaker -->|6. Increment Counter| FailureCounter
    FailureCounter -->|7. Check Threshold| StateManager

    %% State Transition to OPEN
    StateManager -->|8. Threshold Exceeded| StateManager
    StateManager -->|9. Transition to OPEN| OpenState
    StateManager -->|10. Start Timer| StateManager
    StateManager -->|11. Alert| AlertManager

    %% OPEN State
    WebhookService -->|12. Request| CircuitBreaker
    CircuitBreaker -->|13. Check State| StateManager
    StateManager -->|14. OPEN - Block| CircuitBreaker
    CircuitBreaker -->|15. Use Fallback| FallbackHandler
    FallbackHandler -->|16. Return Cached| WebhookService
    CircuitBreaker -->|17. Queue Retry| RetryQueue

    %% Transition to HALF-OPEN
    StateManager -->|18. Timeout Elapsed| StateManager
    StateManager -->|19. Transition to HALF-OPEN| HalfOpenState
    StateManager -->|20. Allow Test Requests| CircuitBreaker

    %% HALF-OPEN State
    WebhookService -->|21. Test Request| CircuitBreaker
    CircuitBreaker -->|22. Check State| StateManager
    StateManager -->|23. HALF-OPEN - Limited Allow| CircuitBreaker
    CircuitBreaker -->|24. Execute Test| ExternalWebhook
    ExternalWebhook -->|25a. Test Success| CircuitBreaker
    CircuitBreaker -->|26. Increment Success| HealthChecker
    HealthChecker -->|27. Success Threshold Met| StateManager
    StateManager -->|28. Transition to CLOSED| ClosedState

    ExternalWebhook -->|25b. Test Failed| CircuitBreaker
    CircuitBreaker -->|26. Record Failure| HealthChecker
    HealthChecker -->|27. Test Failed| StateManager
    StateManager -->|28. Transition to OPEN| OpenState

    %% Monitoring
    CircuitBreaker -.Metrics.-> MetricsCollector
    StateManager -.Metrics.-> MetricsCollector
    FailureCounter -.Metrics.-> MetricsCollector
    MetricsCollector --> Dashboard
    AlertManager --> Dashboard

    %% Service Health
    ExternalWebhook -.Health Check.-> ServiceMonitor
    ServiceMonitor --> Dashboard

    %% Configuration
    Config -.Configure.-> CircuitBreaker
    Config -.Configure.-> StateManager

    %% Key Characteristics
    Note1["Circuit Breaker Benefits:<br/>✓ Fail fast behavior<br/>✓ Prevents cascade failures<br/>✓ Automatic recovery<br/>✓ Service isolation<br/>✓ Graceful degradation"]

    Note2["Implementation Details:<br/>- Sliding window counter<br/>- Configurable thresholds<br/>- State transition logic<br/>- Fallback mechanisms<br/>- Retry queue integration<br/>- Metrics + alerting"]

    Note3["Use Cases:<br/>- Webhook delivery<br/>- External API calls<br/>- Payment processing<br/>- Email sending<br/>- NOSTR relay connections<br/>- Exchange rate APIs"]

    Note4["Best Practices:<br/>1. Set appropriate thresholds<br/>2. Implement fallbacks<br/>3. Monitor circuit state<br/>4. Alert on transitions<br/>5. Test recovery paths<br/>6. Document behavior"]

