    style ContentRepo fill:#2196f3,stroke:#1565c0,stroke-width:2px,color:#fff
    style UserRepo fill:#4caf50,stroke:#2e7d32,stroke-width:2px,color:#fff
    style PaymentRepo fill:#ff9800,stroke:#e65100,stroke-width:2px,color:#fff

