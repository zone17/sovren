    style ReadReplica2 fill:#4caf50,stroke:#2e7d32,stroke-width:2px,color:#fff

    style Note1 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style Note2 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
