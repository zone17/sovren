%% =====================================================
%% US-311: Unified NOSTR Session Management - Architecture Overview
%% WHY: Visualize the complete session management architecture
%% =====================================================

graph TB
    subgraph "Client Layer"
        Frontend[Frontend Application]
        Mobile[Mobile App]
        Desktop[Desktop Client]
    end

    subgraph "Session Management Layer"
        USM[UnifiedSessionManager<br/>Abstract Base Class]

        subgraph "Backend Implementation"
            BSM[DatabaseSessionManager<br/>Supabase/PostgreSQL]
        end

        subgraph "Frontend Implementation"
            FSM[BrowserSessionManager<br/>IndexedDB]
        end
    end

    subgraph "Storage Layer"
        subgraph "Database"
            Sessions[(unified_sessions<br/>Table)]
            Activities[(unified_session_activities<br/>Table)]
        end

        subgraph "Browser"
            IDB[(IndexedDB<br/>sessions & activities)]
        end
    end

    subgraph "Core Features"
        Create[Session Creation<br/>sess_pubkey_time_random]
        Validate[Session Validation<br/>Expiry & Idle Check]
        Refresh[Session Refresh<br/>Auto/Manual]
        Revoke[Session Revocation<br/>Single/Bulk]
        MultiDevice[Multi-Device Support<br/>Max 5 per pubkey]
        Activity[Activity Tracking<br/>Audit Trail]
    end

    Frontend --> FSM
    Mobile --> BSM
    Desktop --> BSM

    USM -.implements.-> BSM
    USM -.implements.-> FSM

    BSM --> Sessions
    BSM --> Activities
    FSM --> IDB

    BSM --> Create
    BSM --> Validate
    BSM --> Refresh
    BSM --> Revoke
    BSM --> MultiDevice
    BSM --> Activity

    FSM --> Create
    FSM --> Validate
    FSM --> Refresh
    FSM --> Revoke
    FSM --> MultiDevice
    FSM --> Activity

    style USM fill:#ff9800,stroke:#e65100,stroke-width:3px,color:#fff
    style BSM fill:#2196f3,stroke:#0d47a1,stroke-width:2px,color:#fff
    style FSM fill:#4caf50,stroke:#1b5e20,stroke-width:2px,color:#fff
    style Sessions fill:#9c27b0,stroke:#4a148c,stroke-width:2px,color:#fff
    style Activities fill:#9c27b0,stroke:#4a148c,stroke-width:2px,color:#fff
    style IDB fill:#9c27b0,stroke:#4a148c,stroke-width:2px,color:#fff
