graph TB
    %% NOSTR Relay Connection Management - Sovren Platform
    %% Shows relay pool initialization, health monitoring, reconnection, and load balancing

    subgraph "Initialization Phase"
        START[Application Start]
        CONFIG[Load Relay Config<br/>from Environment]
        PARSE[Parse Relay URLs<br/>Validate Format]
        PRIORITY[Assign Priority Levels<br/>Primary/Secondary/Backup]
    end

    subgraph "Relay Pool Manager"
        POOL[SimplePool Instance<br/>nostr-tools]
        CONNECT[Connection Manager]
        HEALTH[Health Monitor]
        FAILOVER[Failover Controller]
        BALANCE[Load Balancer]
    end

    subgraph "Connection States"
        CONNECTING[Connecting<br/>WebSocket Handshake]
        CONNECTED[Connected<br/>Ready for Events]
        DEGRADED[Degraded<br/>High Latency]
        DISCONNECTED[Disconnected<br/>Connection Lost]
        FAILED[Failed<br/>Max Retries Exceeded]
    end

    subgraph "Primary Relays"
        R1[wss://relay.damus.io<br/>Priority: 1<br/>Region: US]
        R2[wss://relay.nostr.band<br/>Priority: 1<br/>Region: EU]
        R3[wss://nos.lol<br/>Priority: 1<br/>Region: Global]
    end

    subgraph "Secondary Relays"
        R4[wss://relay.snort.social<br/>Priority: 2<br/>Region: US]
        R5[wss://nostr.wine<br/>Priority: 2<br/>Region: EU]
    end

    subgraph "Backup Relays"
        R6[wss://relay.sovren.app<br/>Priority: 3<br/>Self-hosted]
        R7[Custom User Relays<br/>Priority: 3]
    end

    subgraph "Health Monitoring"
        PING[Ping/Pong Monitor<br/>Every 30s]
        LATENCY[Latency Tracker<br/>Response Times]
        UPTIME[Uptime Calculator<br/>Success Rate]
        EVENTS[Event Throughput<br/>Events/sec]
    end

    subgraph "Metrics Collection"
        M1[Connection Time<br/>Initial + Reconnect]
        M2[Response Latency<br/>Avg/Min/Max]
        M3[Success Rate<br/>Successful/Total]
        M4[Error Types<br/>Categorized]
        M5[Event Count<br/>Published/Received]
    end

    subgraph "Failover Logic"
        DETECT[Detect Failure<br/>Timeout/Error]
        SCORE[Update Health Score<br/>Penalize Failed Relay]
        SELECT[Select Replacement<br/>Best Available Relay]
        SWITCH[Switch Traffic<br/>To Backup Relay]
        NOTIFY[Notify User<br/>Optional Alert]
    end

    subgraph "Reconnection Strategy"
        BACKOFF[Exponential Backoff<br/>2s → 4s → 8s → 16s]
        MAXRETRY[Max Retry Limit<br/>5 attempts]
        COOLDOWN[Cooldown Period<br/>5 minutes]
        RETEST[Retest Failed Relay<br/>Background Checks]
    end

    subgraph "Load Balancing"
        ROUND[Round Robin<br/>Distribute Evenly]
        LATENCY_LB[Latency-Based<br/>Prefer Fast Relays]
        GEO[Geo-Routing<br/>Nearest Relay]
        RANDOM[Random Selection<br/>Fault Tolerance]
    end

    %% Initialization Flow
    START --> CONFIG
    CONFIG --> PARSE
    PARSE --> PRIORITY
    PRIORITY --> POOL

    %% Pool to Connection Manager
    POOL --> CONNECT
    CONNECT --> HEALTH
    HEALTH --> FAILOVER
    FAILOVER --> BALANCE

    %% Connection to Relays
    CONNECT -.-> CONNECTING
    CONNECTING --> R1
    CONNECTING --> R2
    CONNECTING --> R3
    CONNECTING --> R4
    CONNECTING --> R5
    CONNECTING --> R6
    CONNECTING --> R7

    %% Connection State Transitions
    CONNECTING --> CONNECTED
    CONNECTED --> DEGRADED
    DEGRADED --> DISCONNECTED
    DISCONNECTED --> FAILED
    CONNECTED --> DISCONNECTED

    %% Health Monitoring
    HEALTH --> PING
    HEALTH --> LATENCY
    HEALTH --> UPTIME
    HEALTH --> EVENTS

    %% Metrics Flow
    PING --> M1
    LATENCY --> M2
    UPTIME --> M3
    EVENTS --> M5
    DISCONNECTED --> M4

    %% Failover Process
    DISCONNECTED --> DETECT
    DETECT --> SCORE
    SCORE --> SELECT
    SELECT --> SWITCH
    SWITCH --> NOTIFY

    %% Reconnection Flow
    FAILED --> BACKOFF
    BACKOFF --> MAXRETRY
    MAXRETRY --> COOLDOWN
    COOLDOWN --> RETEST
    RETEST --> CONNECTING

    %% Load Balancing Strategies
    BALANCE --> ROUND
    BALANCE --> LATENCY_LB
    BALANCE --> GEO
    BALANCE --> RANDOM

    %% Feedback Loops
    M2 -.-> LATENCY_LB
    M3 -.-> SCORE
    SCORE -.-> SELECT
    SELECT -.-> SWITCH

