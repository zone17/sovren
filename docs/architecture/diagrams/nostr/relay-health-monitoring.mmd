graph LR
    subgraph "Health Check Cycle"
        Start([Every 30s]) --> CheckAll[Check All Relays]
        CheckAll --> Measure
    end

    subgraph "Metrics Collection"
        Measure[Measure Metrics] --> Latency[Latency Test]
        Measure --> Success[Success Rate]
        Measure --> Uptime[Uptime %]

        Latency --> Score
        Success --> Score
        Uptime --> Score
    end

    subgraph "Health Scoring"
        Score[Calculate<br/>Health Score] --> Rate{Score Rating}

        Rate -->|90-100| Excellent[Excellent<br/>Priority 1]
        Rate -->|70-89| Good[Good<br/>Priority 2]
        Rate -->|50-69| Fair[Fair<br/>Priority 3]
        Rate -->|0-49| Poor[Poor<br/>Degraded]
    end

    subgraph "Actions"
        Poor --> Disconnect{Persistent?}
        Disconnect -->|Yes| Remove[Remove from Pool]
        Disconnect -->|No| Reconnect[Schedule Reconnect]

        Excellent --> Prefer[Add to Preferred List]
        Good --> Continue[Continue Monitoring]
        Fair --> Warning[Emit Warning Event]
    end

    subgraph "Relay Selection"
        Prefer --> FastestFirst[Fastest First Strategy]
        Continue --> RoundRobin[Round Robin Strategy]
        Warning --> Fallback[Fallback Strategy]

        FastestFirst --> Publish[Publish Events]
        RoundRobin --> Publish
        Fallback --> Publish
    end

    Remove --> Cleanup[Cleanup Resources]
    Reconnect --> BackoffTimer[Exponential Backoff]
    BackoffTimer --> CheckAll

    style Excellent fill:#50C878,stroke:#2E7D4E,color:#fff
    style Good fill:#4A90E2,stroke:#2E5C8A,color:#fff
    style Fair fill:#F5A623,stroke:#C17D11,color:#fff
    style Poor fill:#E94B3C,stroke:#B8352A,color:#fff
