sequenceDiagram
    %% NOSTR Event Publishing Flow - Sovren Platform
    %% Complete lifecycle from event creation to multi-relay broadcasting

    participant Creator as Content Creator
    participant UI as Content Editor UI
    participant Validator as Event Validator
    participant Signer as Signing Service
    participant KMS as Key Management
    participant Publisher as Event Publisher
    participant Pool as Relay Pool
    participant R1 as Relay 1<br/>(relay.damus.io)
    participant R2 as Relay 2<br/>(relay.nostr.band)
    participant R3 as Relay 3<br/>(nos.lol)

    %% Event Creation Phase
    rect rgb(240, 248, 255)
        Note over Creator,Pool: Event Creation Phase
        Creator->>UI: Create Content
        UI->>UI: Compose Event Data

        Note right of UI: Event Types:<br/>• kind 1: Text Note<br/>• kind 3: Contact List<br/>• kind 4: Encrypted DM<br/>• kind 30023: Long-form<br/>• kind 30078: App Data

        UI->>Validator: validateEventData(draft)

        Validator->>Validator: Check Required Fields
        Note right of Validator: Required:<br/>• content<br/>• kind<br/>• tags (optional)

        Validator->>Validator: Validate Content Length
        alt Content Too Long
            Validator-->>UI: Validation Error
            UI->>Creator: Show Error Message
        end

        Validator->>Validator: Sanitize Content
        Note right of Validator: Remove XSS vectors,<br/>validate URLs,<br/>check markdown

        Validator->>Validator: Process Tags
        Note right of Validator: Tags:<br/>• e (event refs)<br/>• p (pubkey refs)<br/>• t (hashtags)<br/>• d (identifiers)

        Validator-->>UI: Validation Passed
    end

    %% Event Signing Phase
    rect rgb(240, 255, 240)
        Note over Creator,Pool: Event Signing Phase
        UI->>Signer: signEvent(eventData)

        Signer->>KMS: Get Active Key
        KMS-->>Signer: Public Key

        Signer->>Signer: Build Event Object
        Note right of Signer: {<br/>  kind: number<br/>  content: string<br/>  tags: array<br/>  created_at: timestamp<br/>  pubkey: hex<br/>}

        Signer->>Signer: Calculate Event ID
        Note right of Signer: SHA256 hash of<br/>serialized event

        Signer->>KMS: Sign Event Hash
        Note right of KMS: Schnorr signature<br/>using secp256k1

        alt Using Browser Extension
            KMS->>Creator: Request Signature Approval
            Creator->>KMS: Approve
            KMS->>KMS: Sign via Extension
        else Using Stored Key
            KMS->>KMS: Decrypt Private Key
            KMS->>KMS: Sign Event
            KMS->>KMS: Clear Key from Memory
        end

        KMS-->>Signer: Signature (hex)

        Signer->>Signer: Attach Signature
        Signer->>Signer: Verify Signature
        Note right of Signer: Validate signature<br/>matches event ID

        alt Signature Invalid
            Signer-->>UI: Signature Error
            UI->>Creator: Show Error
        end

        Signer-->>UI: Signed Event Ready
    end

    %% Publishing Phase
    rect rgb(255, 250, 240)
        Note over Creator,Pool: Multi-Relay Publishing Phase
        UI->>Publisher: publishEvent(signedEvent)

        Publisher->>Pool: Get Connected Relays
        Pool-->>Publisher: Relay List (3+ relays)

        Publisher->>Publisher: Create Publish Promises
        Note right of Publisher: Parallel publishing<br/>to all relays

        %% Parallel publishing
        par Publish to Relay 1
            Publisher->>R1: EVENT message
            Note right of R1: ["EVENT", {...}]
            R1->>R1: Validate Event
            R1->>R1: Store Event
            R1-->>Publisher: OK message
            Note left of R1: ["OK", event_id,<br/> true, ""]
        and Publish to Relay 2
            Publisher->>R2: EVENT message
            R2->>R2: Validate Event
            R2->>R2: Store Event
            R2-->>Publisher: OK message
        and Publish to Relay 3
            Publisher->>R3: EVENT message
            R3->>R3: Validate Event
            R3->>R3: Check Rate Limits
            alt Rate Limited
                R3-->>Publisher: ERROR message
                Note left of R3: ["OK", event_id,<br/> false, "rate-limited"]
            else Success
                R3->>R3: Store Event
                R3-->>Publisher: OK message
            end
        end
    end

    %% Result Aggregation Phase
    rect rgb(255, 240, 245)
        Note over Creator,Pool: Result Aggregation Phase
        Publisher->>Publisher: Collect Responses

        Publisher->>Publisher: Calculate Success Rate
        Note right of Publisher: Success if:<br/>• 2/3 relays succeeded<br/>• At least 1 succeeded

        alt Majority Success
            Publisher->>Publisher: Mark as Published
            Publisher->>Publisher: Update Local Cache
            Publisher-->>UI: Publish Success
            UI->>Creator: Show Success + Relay Stats
            Note right of UI: "Published to<br/>3/3 relays"

        else Partial Success
            Publisher->>Publisher: Mark as Partially Published
            Publisher-->>UI: Partial Success
            UI->>Creator: Show Warning + Stats
            Note right of UI: "Published to<br/>2/3 relays<br/>Relay 3 failed"

        else Complete Failure
            Publisher-->>UI: Publish Failed
            UI->>Creator: Show Error + Retry Option
        end
    end

    %% Error Handling & Retry
    rect rgb(255, 245, 240)
        Note over Creator,Pool: Error Handling & Retry
        alt Relay Timeout
            Publisher->>Publisher: Wait for Response (10s)
            Publisher->>Publisher: Timeout Exceeded
            Publisher->>Publisher: Mark Relay as Failed
            Note right of Publisher: Relay health<br/>score decreased

        else Network Error
            Publisher->>Publisher: Detect Connection Lost
            Publisher->>Pool: Request Reconnect
            Pool->>Pool: Attempt Reconnection
            alt Reconnect Success
                Pool-->>Publisher: Relay Reconnected
                Publisher->>Creator: Prompt to Retry
            else Reconnect Failed
                Pool-->>Publisher: Relay Unavailable
                Publisher->>Publisher: Remove from Active Pool
            end

        else Invalid Event (Relay Rejection)
            R1-->>Publisher: ERROR: duplicate event
            Publisher->>Publisher: Log Rejection Reason
            Publisher-->>UI: Event Rejected
            UI->>Creator: Show Specific Error
            Note right of UI: "Event already<br/>published"
        end
    end

    %% Retry Logic
    rect rgb(245, 240, 255)
        Note over Creator,Pool: Automatic Retry Logic
        alt Transient Failure Detected
            Publisher->>Publisher: Check Retry Count
            alt Retries < 3
                Publisher->>Publisher: Wait (Exponential Backoff)
                Note right of Publisher: Delays:<br/>• 1st retry: 2s<br/>• 2nd retry: 4s<br/>• 3rd retry: 8s

                Publisher->>Publisher: Increment Retry Count
                Publisher->>R1: EVENT message (retry)
                R1-->>Publisher: OK message
                Publisher-->>UI: Retry Successful
            else Max Retries Reached
                Publisher-->>UI: Publish Failed (Final)
                UI->>Creator: Show Error + Manual Retry
            end
        end
    end

    %% Broadcasting to Followers
    rect rgb(240, 255, 255)
        Note over Creator,Pool: Follower Notification
        Publisher->>Publisher: Check Event Type
        alt Public Event (kind 1, 30023)
            Publisher->>Pool: Broadcast to All Relays
            Note right of Pool: Followers subscribed<br/>to creator's pubkey<br/>will receive event

            Pool->>R1: Notify Subscribers
            Pool->>R2: Notify Subscribers
            Pool->>R3: Notify Subscribers

            Note over R1,R3: Relays push event to<br/>subscribed clients via<br/>WebSocket connections

        else Private Event (kind 4)
            Publisher->>Publisher: Encrypt Content
            Note right of Publisher: NIP-04 encryption<br/>using recipient's<br/>public key

            Publisher->>Pool: Publish Encrypted Event
            Note right of Pool: Only recipient<br/>can decrypt
        end
    end

    %% Post-Publishing Tasks
    rect rgb(255, 240, 240)
        Note over Creator,Pool: Post-Publishing Tasks
        Publisher->>Publisher: Update Analytics
        Note right of Publisher: Track:<br/>• Publish time<br/>• Relay success rate<br/>• Event ID

        Publisher->>Publisher: Update Local Database
        Note right of Publisher: Cache event locally<br/>for offline viewing

        Publisher->>Publisher: Trigger Indexing
        Note right of Publisher: Update search index,<br/>content graph

        Publisher-->>UI: Complete
        UI->>Creator: Event Published Successfully
    end

    %% Event State Transitions
    Note over Creator: Event States:<br/>• DRAFT: Being composed<br/>• VALIDATING: Checking data<br/>• SIGNING: Awaiting signature<br/>• PUBLISHING: Sending to relays<br/>• PUBLISHED: Confirmed on relays<br/>• FAILED: Publishing failed

    Note over Pool: Relay Selection:<br/>• Primary relays (always)<br/>• User-preferred relays<br/>• Geo-optimized relays<br/>• Backup relays (on failure)

    Note over Publisher: Success Criteria:<br/>• ≥2 relays confirmed<br/>• Response time <10s<br/>• Valid OK message<br/>• Event ID matches
