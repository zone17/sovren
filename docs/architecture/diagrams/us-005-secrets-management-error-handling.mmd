%% Secrets Management System - Error Handling Flow
%% User Story: US-005
%% Description: Comprehensive error handling and retry logic

graph TB
    START[getSecret Request] --> INITIALIZED{Service<br/>Initialized?}

    INITIALIZED -->|No| ERROR_INIT[Throw: Not Initialized]
    INITIALIZED -->|Yes| CHECK_CACHE{In Cache?}

    CHECK_CACHE -->|Yes| VALIDATE_TTL{TTL<br/>Expired?}
    VALIDATE_TTL -->|No| RETURN_CACHED[Return Cached Value]
    VALIDATE_TTL -->|Yes| CLEAR_CACHE[Remove from Cache]
    CLEAR_CACHE --> LOAD

    CHECK_CACHE -->|No| LOAD{Load<br/>Source?}

    LOAD -->|AWS Mode| AWS_CALL[AWS GetSecretValue]

    AWS_CALL --> AWS_RESULT{Result}

    AWS_RESULT -->|Success| PARSE_VALUE{JSON<br/>Secret?}
    PARSE_VALUE -->|Yes| EXTRACT_KEY[Extract JSON Key]
    PARSE_VALUE -->|No| USE_STRING[Use SecretString]

    EXTRACT_KEY --> KEY_EXISTS{Key<br/>Exists?}
    KEY_EXISTS -->|Yes| CACHE_SUCCESS[Cache Value]
    KEY_EXISTS -->|No| ERROR_INVALID_KEY[Error: JSON Key Not Found]

    USE_STRING --> CACHE_SUCCESS
    CACHE_SUCCESS --> RETURN_VALUE[Return Value]

    AWS_RESULT -->|ResourceNotFound| CHECK_REQUIRED{Required<br/>Secret?}
    AWS_RESULT -->|InvalidRequest| ERROR_INVALID[Error: Invalid Secret Request]
    AWS_RESULT -->|NetworkError| RETRY_LOGIC{Retry<br/>Attempts<br/>Remaining?}

    RETRY_LOGIC -->|Yes| BACKOFF[Exponential Backoff<br/>1s → 2s → 4s]
    BACKOFF --> AWS_CALL
    RETRY_LOGIC -->|No| CHECK_REQUIRED

    CHECK_REQUIRED -->|Yes + Production| ERROR_NOT_FOUND[Error: Secret Not Found]
    CHECK_REQUIRED -->|No or Dev| ENV_FALLBACK[Try Environment Variable]

    LOAD -->|Development Mode| ENV_FALLBACK

    ENV_FALLBACK --> ENV_EXISTS{Env Var<br/>Set?}
    ENV_EXISTS -->|Yes| CACHE_ENV[Cache Env Value]
    ENV_EXISTS -->|No| OPTIONAL_CHECK{Optional<br/>Secret?}

    CACHE_ENV --> RETURN_VALUE

    OPTIONAL_CHECK -->|Yes| RETURN_EMPTY[Return Empty String]
    OPTIONAL_CHECK -->|No| ERROR_REQUIRED[Error: Required Secret Missing]

    %% Error Tracking
    ERROR_INIT --> LOG_ERROR[Log Error<br/>Increment Stats]
    ERROR_NOT_FOUND --> LOG_ERROR
    ERROR_INVALID --> LOG_ERROR
    ERROR_INVALID_KEY --> LOG_ERROR
    ERROR_REQUIRED --> LOG_ERROR

    LOG_ERROR --> THROW[Throw SecretError]

    %% Success Tracking
    RETURN_CACHED -.stats.-> CACHE_HIT[Increment Cache Hits]
    CACHE_SUCCESS -.stats.-> CACHE_MISS[Increment Cache Misses]
    AWS_CALL -.stats.-> AWS_CALLS[Increment AWS Calls]
    ENV_FALLBACK -.stats.-> ENV_FALLBACKS[Increment Env Fallbacks]

    %% Styling
    classDef start fill:#e3f2fd,stroke:#1976d2
    classDef decision fill:#fff9c4,stroke:#f57f17
    classDef success fill:#c8e6c9,stroke:#2e7d32
    classDef error fill:#ffcdd2,stroke:#c62828
    classDef process fill:#f3e5f5,stroke:#7b1fa2
    classDef cache fill:#e1f5ff,stroke:#0277bd

    class START start
    class INITIALIZED,CHECK_CACHE,VALIDATE_TTL,AWS_RESULT,PARSE_VALUE,KEY_EXISTS,CHECK_REQUIRED,RETRY_LOGIC,ENV_EXISTS,OPTIONAL_CHECK decision
    class RETURN_VALUE,RETURN_CACHED,RETURN_EMPTY success
    class ERROR_INIT,ERROR_NOT_FOUND,ERROR_INVALID,ERROR_INVALID_KEY,ERROR_REQUIRED,LOG_ERROR,THROW error
    class LOAD,AWS_CALL,EXTRACT_KEY,USE_STRING,BACKOFF,ENV_FALLBACK process
    class CACHE_SUCCESS,CACHE_ENV,CLEAR_CACHE,CACHE_HIT,CACHE_MISS cache
