```mermaid
graph TB
    subgraph "Threat Model: NIP-04 Encrypted DMs"
        subgraph "Assets"
            PK[Private Keys]
            MSG[Message Content]
            META[Metadata]
            SESS[Session Keys]
        end

        subgraph "Threats"
            T1[T1: Key Extraction<br/>SEVERITY: CRITICAL]
            T2[T2: Man-in-the-Middle<br/>SEVERITY: HIGH]
            T3[T3: Replay Attacks<br/>SEVERITY: MEDIUM]
            T4[T4: Timing Attacks<br/>SEVERITY: MEDIUM]
            T5[T5: Spam/DoS<br/>SEVERITY: MEDIUM]
            T6[T6: Message Tampering<br/>SEVERITY: HIGH]
            T7[T7: IV Reuse<br/>SEVERITY: CRITICAL]
            T8[T8: Known Plaintext<br/>SEVERITY: LOW]
            T9[T9: Session Rollback<br/>SEVERITY: MEDIUM]
            T10[T10: Memory Leaks<br/>SEVERITY: LOW]
        end

        subgraph "Mitigations"
            M1[M1: Never log/store private keys<br/>Store in KeyManagementService only]
            M2[M2: ECDH + secp256k1<br/>Public key cryptography]
            M3[M3: Message IDs + Timestamps<br/>Detect duplicate messages]
            M4[M4: Constant-time operations<br/>No branching on secrets]
            M5[M5: Rate limiting<br/>10/min, 200/hr per sender]
            M6[M6: No HMAC in NIP-04<br/>Note: Integrity not guaranteed]
            M7[M7: CSPRNG IV generation<br/>Unique IV per message]
            M8[M8: Unique IV per encryption<br/>Different ciphertext each time]
            M9[M9: Session key rotation<br/>100 message threshold]
            M10[M10: Cleanup on destroy()<br/>Clear all caches]
        end

        subgraph "Security Controls"
            C1[Input Validation<br/>All inputs sanitized]
            C2[Proof of Work<br/>16-bit difficulty option]
            C3[Block/Allow Lists<br/>Sender filtering]
            C4[Read Receipts<br/>Kind 1515 events]
            C5[Forward Secrecy<br/>Session key rotation]
            C6[Message Cache<br/>LRU eviction]
        end

