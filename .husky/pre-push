#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Sovren Pre-Push Quality Gate
# Final protection before code reaches remote repository
# Uses git diff origin/main...HEAD to compare branch changes (not --cached)

echo "Running pre-push quality verification..."

# 1. Ensure we're not pushing to main/master without proper review
protected_branch='main'
current_branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$current_branch" = "$protected_branch" ]; then
  echo "WARNING: Pushing directly to $protected_branch branch"
  echo "Consider using feature branches and pull requests for better code review"
fi

# 2. Final test suite run
echo "Running final test verification..."
npm test -- --passWithNoTests
if [ $? -ne 0 ]; then
  echo "FAIL: Test suite failed! Cannot push."
  exit 1
fi

# 3. Verify no TODO/FIXME comments in changed production code
echo "Checking for development markers..."
changed_files=$(git diff origin/main...HEAD --name-only 2>/dev/null || git diff HEAD~1...HEAD --name-only)
todo_count=$(echo "$changed_files" | xargs grep -l "TODO\|FIXME\|XXX\|HACK" 2>/dev/null | wc -l | tr -d ' ')
if [ "$todo_count" -gt 0 ]; then
  echo "WARNING: Found TODO/FIXME markers in changed files:"
  echo "$changed_files" | xargs grep -n "TODO\|FIXME\|XXX\|HACK" 2>/dev/null || true
  echo ""
  echo "Consider resolving these before pushing to maintain code quality"
fi

# 4. Check for console.log statements in changed production code
# Excludes test files, spec files, and markdown
echo "Checking for debug statements..."
src_files=$(echo "$changed_files" | grep -E '\.(ts|tsx|js|jsx)$' | grep -vE '\.(test|spec)\.(ts|tsx|js|jsx)$' | grep -v '\.md$')
debug_count=$(echo "$src_files" | xargs grep -l "console\." 2>/dev/null | wc -l | tr -d ' ')
if [ "$debug_count" -gt 0 ]; then
  echo "WARNING: Found console statements in changed source files:"
  echo "$src_files" | xargs grep -n "console\." 2>/dev/null || true
  echo ""
  echo "Consider removing debug statements before pushing"
fi

# 5. Verify docs are up to date if package.json changed
if echo "$changed_files" | grep -q "package\.json"; then
  echo "Package.json changed - remember to update DEVELOPER_GUIDE.md if dependencies changed"
fi

echo "Pre-push verification complete"
