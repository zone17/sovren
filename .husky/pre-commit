#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Sovren Pre-Commit Quality Gates
# Fast checks only: anti-patterns, lint-staged, related unit tests
# Target: <60s. Build and Vercel validation moved to CI.

echo "Running pre-commit quality gates..."

# 1. Anti-pattern scanner (fast, runs first for quick feedback)
bash scripts/check-antipatterns.sh

# 2. Run lint-staged for code formatting and linting
echo "Checking code formatting and linting..."
npx lint-staged

# 3. Run related unit tests for staged files (both frontend and backend)
echo "Running related unit tests for staged files..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [ -n "$STAGED_FILES" ]; then
  # Backend/shared related tests
  BACKEND_FILES=$(echo "$STAGED_FILES" | grep -E '^packages/(backend|shared)/' || true)
  if [ -n "$BACKEND_FILES" ]; then
    echo "$BACKEND_FILES" | xargs npx jest --findRelatedTests --passWithNoTests --bail 2>/dev/null || true
  fi

  # Frontend related tests
  FRONTEND_FILES=$(echo "$STAGED_FILES" | grep -E '^packages/frontend/' || true)
  if [ -n "$FRONTEND_FILES" ]; then
    echo "$FRONTEND_FILES" | xargs npx jest --findRelatedTests --passWithNoTests --bail 2>/dev/null || true
  fi
fi

echo "All quality gates passed! Ready to commit."
