# Sovren Elite Development Environment Variables
# Docker Compose Configuration

# ====================================================================
# GENERAL CONFIGURATION
# ====================================================================

# Environment
NODE_ENV=development
LOG_LEVEL=debug
TZ=UTC

# Application Configuration
APP_NAME=Sovren
APP_VERSION=1.0.0
APP_URL=http://localhost:3001

# ====================================================================
# SUPABASE CONFIGURATION
# ====================================================================

# Supabase Project Settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ====================================================================
# AUTHENTICATION & SECURITY
# ====================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=24h

# MCP Gateway Configuration
MCP_ADMIN_PASSWORD=admin123
MCP_JWT_SECRET=your-mcp-jwt-secret-key

# ====================================================================
# DATABASE CONFIGURATION
# ====================================================================

# PostgreSQL Development Database
POSTGRES_DB=sovren_dev
POSTGRES_USER=sovren
POSTGRES_PASSWORD=dev_password_change_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sovren:dev_password_change_in_production@postgres:5432/sovren_dev

# PostgreSQL Test Database
POSTGRES_TEST_DB=sovren_test
POSTGRES_TEST_USER=sovren_test
POSTGRES_TEST_PASSWORD=test_password
POSTGRES_TEST_HOST=postgres-test
POSTGRES_TEST_PORT=5432
DATABASE_TEST_URL=postgresql://sovren_test:test_password@postgres-test:5432/sovren_test

# ====================================================================
# REDIS CONFIGURATION
# ====================================================================

# Redis Development Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_password
REDIS_URL=redis://redis:6379

# Redis Test Cache
REDIS_TEST_HOST=redis-test
REDIS_TEST_PORT=6379
REDIS_TEST_URL=redis://redis-test:6379

# ====================================================================
# LIGHTNING NETWORK CONFIGURATION
# ====================================================================

# LNbits Configuration
LNBITS_API_URL=https://your-lnbits-instance.com
LNBITS_ADMIN_KEY=your-lnbits-admin-key
LNBITS_INVOICE_READ_KEY=your-lnbits-invoice-read-key
LNBITS_WALLET_ID=your-wallet-id

# Lightning Network Settings
LIGHTNING_NETWORK_TYPE=testnet
LIGHTNING_NETWORK_RPC_HOST=localhost
LIGHTNING_NETWORK_RPC_PORT=10009

# ====================================================================
# NOSTR CONFIGURATION
# ====================================================================

# NOSTR Relays (comma-separated)
NOSTR_RELAYS=wss://relay.damus.io,wss://relay.primal.net,wss://relay.snort.social

# NOSTR Keys (for development only)
NOSTR_PRIVATE_KEY=your-nostr-private-key-hex
NOSTR_PUBLIC_KEY=your-nostr-public-key-hex

# ====================================================================
# FRONTEND CONFIGURATION
# ====================================================================

# Vite Configuration
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_LNBITS_API_URL=https://your-lnbits-instance.com
VITE_NOSTR_RELAYS=wss://relay.damus.io,wss://relay.primal.net,wss://relay.snort.social
VITE_APP_NAME=Sovren
VITE_APP_VERSION=1.0.0

# ====================================================================
# MONITORING CONFIGURATION
# ====================================================================

# Prometheus Configuration
PROMETHEUS_RETENTION_TIME=200h
PROMETHEUS_STORAGE_PATH=/prometheus

# Grafana Configuration
GF_SECURITY_ADMIN_PASSWORD=admin123
GF_INSTALL_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource

# ====================================================================
# EMAIL CONFIGURATION
# ====================================================================

# Mailhog Configuration (Development)
MAILHOG_SMTP_HOST=mailhog
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_HOST=mailhog
MAILHOG_WEB_PORT=8025

# Production Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ====================================================================
# DEVELOPMENT TOOLS
# ====================================================================

# File Watching Configuration
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# Debug Configuration
DEBUG=sovren:*

# ====================================================================
# RESOURCE LIMITS
# ====================================================================

# CPU Limits (in cores)
CPU_LIMIT_BACKEND=1.0
CPU_LIMIT_FRONTEND=1.0
CPU_LIMIT_POSTGRES=0.5
CPU_LIMIT_REDIS=0.5

# Memory Limits (in MB)
MEMORY_LIMIT_BACKEND=512
MEMORY_LIMIT_FRONTEND=512
MEMORY_LIMIT_POSTGRES=256
MEMORY_LIMIT_REDIS=256

# ====================================================================
# NETWORK CONFIGURATION
# ====================================================================

# Port Configuration
PORT_BACKEND=3001
PORT_FRONTEND=5173
PORT_POSTGRES=5432
PORT_REDIS=6379
PORT_NGINX=80
PORT_GRAFANA=3000
PORT_PROMETHEUS=9090
PORT_MAILHOG_SMTP=1025
PORT_MAILHOG_WEB=8025

# Network Subnets
SUBNET_MAIN=172.20.0.0/16
SUBNET_DATABASE=172.21.0.0/16
SUBNET_CACHE=172.22.0.0/16
SUBNET_GATEWAY=172.23.0.0/16
SUBNET_MCP=172.24.0.0/16
SUBNET_MONITORING=172.25.0.0/16
SUBNET_TEST=172.26.0.0/16

# ====================================================================
# FEATURE FLAGS
# ====================================================================

# Feature Toggles
FEATURE_NOSTR_AUTH=true
FEATURE_LIGHTNING_PAYMENTS=true
FEATURE_REAL_TIME_ANALYTICS=true
FEATURE_MONITORING=true
FEATURE_DEBUG_MODE=true

# ====================================================================
# TESTING CONFIGURATION
# ====================================================================

# Test Environment
TEST_TIMEOUT=30000
TEST_COVERAGE_THRESHOLD=95
TEST_PARALLEL_WORKERS=4

# ====================================================================
# BACKUP CONFIGURATION
# ====================================================================

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups

# ====================================================================
# CORS CONFIGURATION
# ====================================================================

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization

# ====================================================================
# RATE LIMITING
# ====================================================================

# Rate Limit Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
