{
  "name": "@sovren/backend",
  "version": "0.1.0",
  "description": "Sovren Backend - NOSTR-Native Authentication & User Management Services",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "test": "NODE_ENV=test vitest run --project backend",
    "test:watch": "NODE_ENV=test vitest --project backend",
    "test:ci": "NODE_ENV=test vitest run --project backend --coverage",
    "test:coverage": "NODE_ENV=test vitest run --project backend --coverage",
    "test:integration": "NODE_ENV=test vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "NODE_ENV=test vitest --config vitest.integration.config.ts",
    "test:integration:ui": "NODE_ENV=test vitest --ui --config vitest.integration.config.ts",
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "psql \"$DATABASE_URL\" -f src/database/seed.sql",
    "docker:build": "node ../../scripts/docker-dev-scripts.js build",
    "docker:start": "node ../../scripts/docker-dev-scripts.js start core",
    "docker:stop": "node ../../scripts/docker-dev-scripts.js stop",
    "docker:restart": "node ../../scripts/docker-dev-scripts.js restart",
    "docker:logs": "node ../../scripts/docker-dev-scripts.js logs backend-dev",
    "docker:logs:follow": "node ../../scripts/docker-dev-scripts.js logs backend-dev -f",
    "docker:status": "node ../../scripts/docker-dev-scripts.js status",
    "docker:shell": "node ../../scripts/docker-dev-scripts.js shell backend-dev",
    "docker:clean": "node ../../scripts/docker-dev-scripts.js clean",
    "docker:reset": "node ../../scripts/docker-dev-scripts.js reset",
    "docker:db:shell": "node ../../scripts/docker-dev-scripts.js db shell",
    "docker:db:migrate": "node ../../scripts/docker-dev-scripts.js db migrate",
    "docker:db:seed": "node ../../scripts/docker-dev-scripts.js db seed",
    "docker:db:backup": "node ../../scripts/docker-dev-scripts.js db backup",
    "docker:test": "node ../../scripts/docker-dev-scripts.js test",
    "docker:monitor": "node ../../scripts/docker-dev-scripts.js monitor"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.500.0",
    "@bull-board/api": "^6.18.2",
    "@bull-board/express": "^6.18.2",
    "@elastic/elasticsearch": "^9.2.0",
    "@noble/secp256k1": "^2.2.3",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@sentry/node": "^10.38.0",
    "@supabase/supabase-js": "^2.97.0",
    "argon2": "^0.41.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.69.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dompurify": "^3.0.8",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "inversify": "^7.10.3",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsdom": "^24.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.11",
    "nostr-tools": "^2.23.1",
    "opossum": "^5.0.1",
    "otpauth": "^9.5.0",
    "path-to-regexp": "0.1.12",
    "pdfkit": "^0.15.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "winston": "^3.11.0",
    "ws": "^8.17.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "@types/opossum": "^8.1.9",
    "@types/pdfkit": "^0.17.5",
    "@types/puppeteer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@types/validator": "^13.11.8",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.31.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.1",
    "testcontainers": "^11.12.0",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  }
}
