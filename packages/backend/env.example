# 🚀 Sovren Backend Environment Configuration
# Copy this file to .env and update with your actual values
# Backend environment variables are server-side only and not exposed to the browser

# ==========================================
# 🌐 CORE APPLICATION SETTINGS
# ==========================================

# Environment type - affects logging, error handling, and optimizations
# Values: development | production | test
NODE_ENV=development

# Server port - port the backend API will listen on
# Default: 3001 (avoid conflicts with frontend on 3000)
PORT=3001

# Application log level
# Values: error | warn | info | debug | trace
LOG_LEVEL=info

# Enable request logging middleware
# Values: true | false
ENABLE_REQUEST_LOGGING=true

# ==========================================
# 🗄️ DATABASE CONFIGURATION (REQUIRED)
# ==========================================

# Supabase configuration - get from https://app.supabase.com/project/YOUR_PROJECT/settings/api
# Required for all database operations and authentication
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=30000

# ==========================================
# 🔐 AUTHENTICATION & SECURITY (REQUIRED)
# ==========================================

# JWT secret for token signing and verification
# Generate with: openssl rand -base64 64
# CRITICAL: Must be at least 32 characters, 64+ recommended for production
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production-64-chars-minimum

# Session secret for session management
# Generate with: openssl rand -base64 64
SESSION_SECRET=your-super-secure-session-secret-change-this-in-production-64-chars

# Encryption key for sensitive data (32 characters exactly)
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=your-32-character-encryption-key

# Password hashing rounds (higher = more secure but slower)
# Recommended: 12-15 for production
BCRYPT_ROUNDS=12

# JWT token expiration times
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ==========================================
# ⚡ LIGHTNING NETWORK CONFIGURATION (REQUIRED)
# ==========================================

# LNbits API configuration - get from your LNbits instance
# Required for Lightning Network payment processing
LNBITS_API_URL=https://your-lnbits-instance.com
LNBITS_ADMIN_KEY=your-lnbits-admin-key-here
LNBITS_INVOICE_READ_KEY=your-lnbits-invoice-read-key-here

# Lightning Network webhook secret for payment notifications
# Generate with: openssl rand -hex 32
LNBITS_WEBHOOK_SECRET=your-lnbits-webhook-secret-here

# Lightning Network settings
# Network type: mainnet | testnet | regtest
LIGHTNING_NETWORK=testnet

# Payment amount limits in satoshis
# Minimum: 1000 sats (~$0.30 at $30k BTC)
# Maximum: 100M sats (~$30 at $30k BTC)
LIGHTNING_MIN_AMOUNT=1000
LIGHTNING_MAX_AMOUNT=100000000

# Invoice expiration time in seconds (default: 1 hour)
LIGHTNING_INVOICE_EXPIRY=3600

# ==========================================
# 🌐 NOSTR PROTOCOL CONFIGURATION (REQUIRED)
# ==========================================

# NOSTR relay URLs (comma-separated)
# Use reliable public relays or your own relay
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social,wss://relay.current.fyi

# NOSTR connection settings
NOSTR_CONNECTION_TIMEOUT=5000
NOSTR_MAX_RELAYS=10
NOSTR_RECONNECT_INTERVAL=30000

# Event publishing settings
NOSTR_PUBLISH_TIMEOUT=10000
NOSTR_MAX_PUBLISH_RETRIES=3

# ==========================================
# 📧 EMAIL CONFIGURATION (OPTIONAL)
# ==========================================

# SMTP configuration for transactional emails
# Gmail example - use app passwords: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email addresses
FROM_EMAIL=noreply@your-domain.com
SUPPORT_EMAIL=support@your-domain.com
ADMIN_EMAIL=admin@your-domain.com

# Email templates
EMAIL_TEMPLATE_DIR=./src/templates/email

# ==========================================
# 📁 FILE STORAGE CONFIGURATION (OPTIONAL)
# ==========================================

# AWS S3 configuration for file uploads
# Get from AWS IAM console
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# File upload limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm

# ==========================================
# 🔒 SECURITY & RATE LIMITING (RECOMMENDED)
# ==========================================

# Redis configuration for caching and rate limiting
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate limiting settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# Security headers and CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true
ENABLE_HELMET=true

# Login security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
ACCOUNT_LOCKOUT_THRESHOLD=10

# ==========================================
# 🤖 AI SERVICES CONFIGURATION (OPTIONAL)
# ==========================================

# OpenAI API configuration for AI-powered features
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Anthropic Claude API (alternative to OpenAI)
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# AI service timeouts
AI_REQUEST_TIMEOUT=30000
AI_MAX_RETRIES=3

# ==========================================
# 📊 MONITORING & OBSERVABILITY (RECOMMENDED)
# ==========================================

# Sentry error tracking
# Get from https://sentry.io/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health check configuration
HEALTH_CHECK_TIMEOUT=5000
ENABLE_HEALTH_CHECKS=true

# ==========================================
# 🔧 PERFORMANCE & CACHING
# ==========================================

# API response caching
ENABLE_RESPONSE_CACHING=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# Database query caching
ENABLE_QUERY_CACHING=true
QUERY_CACHE_TTL=600

# Compression settings
ENABLE_COMPRESSION=true
COMPRESSION_THRESHOLD=1024

# ==========================================
# 🚩 FEATURE FLAGS
# ==========================================

# Enable/disable major features
# Values: true | false

# Lightning Network payment processing
FEATURE_LIGHTNING_PAYMENTS=true

# AI-powered content generation
FEATURE_AI_CONTENT_GENERATION=true

# NOSTR protocol publishing
FEATURE_NOSTR_PUBLISHING=true

# Content monetization features
FEATURE_CONTENT_MONETIZATION=true

# Premium subscription features
FEATURE_PREMIUM_SUBSCRIPTIONS=true

# Email notification system
FEATURE_EMAIL_NOTIFICATIONS=false

# File upload functionality
FEATURE_FILE_UPLOADS=true

# Real-time features (WebSocket)
FEATURE_REAL_TIME_UPDATES=true

# ==========================================
# 🧪 DEVELOPMENT & DEBUGGING
# ==========================================

# Enable API documentation (Swagger/OpenAPI)
# Values: true | false
ENABLE_API_DOCS=true

# API documentation path
API_DOCS_PATH=/api/docs

# Debug mode - enables verbose logging and error details
# Values: true | false
DEBUG_MODE=false

# Enable request/response logging
ENABLE_REQUEST_RESPONSE_LOGGING=false

# Database query logging
ENABLE_QUERY_LOGGING=false

# ==========================================
# 🔌 WEBHOOK CONFIGURATION (OPTIONAL)
# ==========================================

# Webhook endpoints for external integrations
WEBHOOK_SECRET=your-webhook-secret-here
WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3

# Payment webhook URLs
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
LNBITS_WEBHOOK_URL=https://your-domain.com/api/webhooks/lnbits

# ==========================================
# 🌍 INTERNATIONALIZATION (OPTIONAL)
# ==========================================

# Default language and locale
DEFAULT_LANGUAGE=en
DEFAULT_LOCALE=en-US
SUPPORTED_LANGUAGES=en,es,fr,de,ja

# Timezone settings
DEFAULT_TIMEZONE=UTC
ENABLE_TIMEZONE_DETECTION=true

# ==========================================
# 📋 ENVIRONMENT-SPECIFIC NOTES
# ==========================================

# DEVELOPMENT SETUP:
# 1. Copy this file to .env
# 2. Set up Supabase project and add URL + keys
# 3. Set up LNbits instance and add API keys
# 4. Configure NOSTR relays (use provided defaults)
# 5. Set JWT_SECRET and SESSION_SECRET (generate with openssl)
# 6. Optional: Set up Redis for caching and rate limiting
# 7. Optional: Add OpenAI API key for AI features
# 8. Run: npm run dev

# PRODUCTION SETUP:
# 1. All REQUIRED variables must be set
# 2. Use strong secrets (64+ characters for JWT/session secrets)
# 3. Set up production database with connection pooling
# 4. Configure proper CORS origins
# 5. Set up monitoring (Sentry, Prometheus)
# 6. Configure rate limiting with Redis
# 7. Set up proper email SMTP
# 8. Use environment variables in deployment platform
# 9. Test thoroughly in staging environment

# SECURITY CHECKLIST:
# □ All secrets are unique and strong (64+ characters)
# □ No default/example values in production
# □ JWT_SECRET is cryptographically secure
# □ Database credentials are restricted
# □ CORS origins are restrictive
# □ Rate limiting is properly configured
# □ HTTPS is enforced in production
# □ Error messages don't leak sensitive information
# □ Webhook secrets are properly configured
# □ File upload restrictions are in place

# PERFORMANCE CHECKLIST:
# □ Database connection pooling is configured
# □ Caching is enabled for appropriate endpoints
# □ Response compression is enabled
# □ Rate limiting prevents abuse
# □ Monitoring is set up for performance tracking
# □ Log levels are appropriate for environment
