# Production Dockerfile for Sovren Backend
# Multi-stage build with Node.js 20 Alpine runtime

# Stage 1: Dependency installation
FROM node:20-alpine AS deps
WORKDIR /app

RUN apk add --no-cache python3 make g++ && \
    rm -rf /var/cache/apk/*

COPY package*.json ./
COPY package-lock.json ./
COPY tsconfig*.json ./

RUN npm ci --include=dev && \
    npm cache clean --force && \
    rm -rf ~/.npm /tmp/*

# Stage 2: Application build
FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package*.json ./
COPY --from=deps /app/tsconfig*.json ./
COPY src/ ./src/
COPY *.json ./
COPY *.js ./

RUN npm run build && \
    npm prune --production && \
    npm cache clean --force

# Stage 3: Production runtime
FROM node:20-alpine AS runtime

LABEL org.opencontainers.image.title="Sovren Backend Production" \
      org.opencontainers.image.description="Lightning Network and NOSTR backend service" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.vendor="Sovren" \
      org.opencontainers.image.licenses="MIT"

RUN apk add --no-cache dumb-init curl ca-certificates && \
    rm -rf /tmp/* /var/cache/apk/*

RUN addgroup -g 1001 -S nodejs && \
    adduser -S backend -u 1001 -G nodejs

WORKDIR /app
RUN chown -R backend:nodejs /app

COPY --from=builder --chown=backend:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=backend:nodejs /app/dist ./dist
COPY --chown=backend:nodejs package*.json ./

USER backend

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3001/health || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/server.js"]
