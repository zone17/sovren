# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials

# Database Configuration (REQUIRED)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Security Configuration (REQUIRED)
JWT_SECRET=generate-a-secure-256-bit-secret-minimum-32-characters
JWT_EXPIRES_IN=24h

# Lightning Network Configuration (REQUIRED for payments)
LNBITS_URL=https://legend.lnbits.com
LNBITS_API_KEY=your-lnbits-api-key-here
LNBITS_WALLET_ID=your-lnbits-wallet-id-here
LIGHTNING_WEBHOOK_SECRET=generate-secure-webhook-secret-minimum-32-characters

# Lightning Network Features (Optional)
WEBHOOK_BASE_URL=https://api.your-domain.com
LNURL_BASE_URL=https://api.your-domain.com
LIGHTNING_ADDRESS_DOMAIN=your-domain.com
ENABLE_LIGHTNING_ADDRESSES=true
ENABLE_LNURL_PAY=true
ENABLE_LIGHTNING_WEBHOOKS=true

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Security Settings (Recommended)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
CORS_ORIGIN=http://localhost:3000

# Database Connection Settings
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=10000

# Testing Configuration
TEST_SUPABASE_URL=http://localhost:54321
TEST_SUPABASE_KEY=test-anon-key

# Monitoring & Logging
LOG_LEVEL=info
METRICS_ENABLED=false

# Performance Settings
CACHE_TTL=300
HEALTH_CHECK_PATH=/health

# Database Connection Pool Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sovren_dev
DB_USER=sovren
DB_PASSWORD=
DB_SSL=false
DATABASE_URL=postgresql://sovren:PASSWORD@localhost:5432/sovren_dev

# Platform Token & BYOK Encryption (REQUIRED for multi-platform features)
# SECURITY (C-5): BYOK key MUST differ from platform token key.
# Generate with: openssl rand -hex 32
PLATFORM_TOKEN_ENCRYPTION_KEY=
# BYOK (Bring Your Own Key) encryption key (MUST differ from PLATFORM_TOKEN_ENCRYPTION_KEY)
# Generate with: openssl rand -hex 32
BYOK_ENCRYPTION_KEY=

# Credential Rotation (Optional)
BACKUP_ENCRYPTION_KEY=
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_NAMESPACE=

# HOW TO GENERATE SECURE SECRETS:
# 1. JWT_SECRET: openssl rand -base64 32
# 2. LIGHTNING_WEBHOOK_SECRET: openssl rand -base64 32
# 3. BACKUP_ENCRYPTION_KEY: openssl rand -base64 32
# 4. PLATFORM_TOKEN_ENCRYPTION_KEY: openssl rand -hex 32
# 5. BYOK_ENCRYPTION_KEY: openssl rand -hex 32 (must differ from PLATFORM_TOKEN_ENCRYPTION_KEY)
# 6. Get Supabase credentials from: https://app.supabase.io
# 7. Get LNbits credentials from: https://legend.lnbits.com