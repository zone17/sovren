# 🌍 Sovren Backend Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# 🔐 AWS SECRETS MANAGER (Production)
# =============================================================================
# Enable AWS Secrets Manager for production/staging environments
# When enabled, secrets will be fetched from AWS instead of environment variables
# FREE tier: 10,000 API calls/month
USE_AWS_SECRETS=false
AWS_REGION=us-east-1

# Required IAM permissions:
# - secretsmanager:GetSecretValue
# - secretsmanager:DescribeSecret
# - secretsmanager:ListSecrets

# =============================================================================
# 🗄️ Database Configuration (REQUIRED)
# =============================================================================
# Get these from your Supabase project dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# PostgreSQL Direct Connection (optional)
DATABASE_URL=postgresql://postgres:password@host:5432/database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sovren_dev
DB_USER=sovren
DB_PASSWORD=dev_password_change_in_production

# =============================================================================
# 🔑 Security Configuration (REQUIRED)
# =============================================================================
# Generate a secure random string for JWT signing
# Should be at least 32 characters long
# Generate: openssl rand -hex 32
JWT_SECRET=your-ultra-secure-256-bit-secret-key-here-minimum-32-characters
JWT_EXPIRES_IN=24h

# =============================================================================
# ⚡ Lightning Network Configuration (REQUIRED for creator monetization)
# =============================================================================
# LNbits server configuration for Bitcoin Lightning payments
LNBITS_URL=https://legend.lnbits.com
LNBITS_API_KEY=your-lnbits-api-key-here
LNBITS_WALLET_ID=your-lnbits-wallet-id-here
LIGHTNING_WEBHOOK_SECRET=your-secure-webhook-secret-minimum-32-characters

# 🔗 Lightning Network Features (Optional)
WEBHOOK_BASE_URL=https://api.sovren.dev
LNURL_BASE_URL=https://api.sovren.dev
LIGHTNING_ADDRESS_DOMAIN=sovren.com
ENABLE_LIGHTNING_ADDRESSES=true
ENABLE_LNURL_PAY=true
ENABLE_LIGHTNING_WEBHOOKS=true

# =============================================================================
# 🐙 GitHub Configuration (REQUIRED for CI/CD dashboard)
# =============================================================================
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=zone17
GITHUB_REPO=sovren

# =============================================================================
# 🌐 Server Configuration
# =============================================================================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# =============================================================================
# 🔒 Security Settings (Optional but Recommended)
# =============================================================================
# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS origins (comma-separated for multiple domains)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# =============================================================================
# 📊 Database Connection Settings (Optional)
# =============================================================================
# Adjust based on your Supabase tier and usage
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=10000
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# =============================================================================
# 🧪 Testing Configuration (Optional)
# =============================================================================
# Only needed if running tests with local Supabase
TEST_SUPABASE_URL=http://localhost:54321
TEST_SUPABASE_KEY=test-anon-key

# =============================================================================
# 📊 Monitoring & Logging (Optional)
# =============================================================================
LOG_LEVEL=info
METRICS_ENABLED=false
ENABLE_LOGGING=true

# =============================================================================
# 🚀 Performance Settings (Optional)
# =============================================================================
CACHE_TTL=300
HEALTH_CHECK_PATH=/health

# =============================================================================
# 👤 Default Admin User (Optional)
# =============================================================================
# NOSTR public key for default admin user creation
# DEFAULT_ADMIN_PUBKEY=your-admin-nostr-public-key

# =============================================================================
# 🔧 Development Settings
# =============================================================================
# Uncomment for development debugging
# NODE_OPTIONS="--inspect"
# DEBUG=express:*

# =============================================================================
# 📝 Notes:
# =============================================================================
# - Never commit actual secrets to version control
# - Use strong, unique secrets for production
# - Keep development and production secrets separate
# - Regularly rotate secrets in production (every 90 days)
# - Store production secrets in AWS Secrets Manager
# - Lightning Network integration requires LNbits server setup
# - Test payments in testnet before production deployment
#
# 🔐 Production Secrets Management:
# - Deploy secrets to AWS: cd infrastructure/terraform && ./scripts/deploy.sh production
# - Enable AWS integration: USE_AWS_SECRETS=true
# - Secrets are cached for 5 minutes to reduce API calls
# - Monitor usage: aws cloudwatch get-metric-statistics --namespace AWS/SecretsManager
#
# 📖 Documentation:
# - AWS Secrets Manager Guide: docs/infrastructure/AWS_SECRETS_MANAGER_GUIDE.md
# - Infrastructure README: infrastructure/terraform/README.md
# - Backend README: packages/backend/README.md
