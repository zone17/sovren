# 🔧 Sovren Shared Package Environment Configuration
# This file contains environment variables used across multiple packages
# Copy relevant variables to your package-specific .env files

# ==========================================
# 🚀 CORE SHARED CONFIGURATION
# ==========================================

# Environment type - affects all packages
# Values: development | production | test
NODE_ENV=development

# Application version (auto-populated by CI/CD)
APP_VERSION=1.0.0

# Build timestamp (auto-populated by CI/CD)
BUILD_TIMESTAMP=

# ==========================================
# 🗄️ SHARED DATABASE CONFIGURATION
# ==========================================

# Supabase configuration shared across frontend and backend
# Get from https://app.supabase.com/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database connection pool settings
DB_MAX_CONNECTIONS=20
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000

# ==========================================
# 🔐 SHARED SECURITY CONFIGURATION
# ==========================================

# JWT configuration used by both frontend and backend
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# Session configuration
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-secure-session-secret-at-least-32-characters-long
SESSION_MAX_AGE=604800

# Encryption keys for sensitive data
# Generate with: openssl rand -hex 16 (32 characters)
ENCRYPTION_KEY=your-32-character-encryption-key

# ==========================================
# ⚡ SHARED LIGHTNING NETWORK CONFIGURATION
# ==========================================

# Lightning Network settings used across packages
LIGHTNING_NETWORK=testnet
LIGHTNING_MIN_AMOUNT=1000
LIGHTNING_MAX_AMOUNT=100000000

# LNbits configuration
LNBITS_API_URL=https://legend.lnbits.com
LNBITS_ADMIN_KEY=your-lnbits-admin-key
LNBITS_INVOICE_READ_KEY=your-lnbits-invoice-read-key
LNBITS_WEBHOOK_SECRET=your-webhook-secret

# Lightning address configuration
LIGHTNING_ADDRESS_DOMAIN=your-domain.com
ENABLE_LIGHTNING_ADDRESSES=true

# ==========================================
# 🌐 SHARED NOSTR CONFIGURATION
# ==========================================

# NOSTR relay configuration shared across packages
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social,wss://relay.current.fyi

# NOSTR connection settings
NOSTR_AUTO_CONNECT=true
NOSTR_CONNECTION_TIMEOUT=5000
NOSTR_MAX_RELAYS=10
NOSTR_CACHE_TTL=300000

# NOSTR event settings
NOSTR_EVENT_TTL=86400
NOSTR_MAX_EVENT_SIZE=65536

# ==========================================
# 🚩 SHARED FEATURE FLAGS
# ==========================================

# Core feature flags that affect multiple packages
# Values: true | false

# Lightning Network integration
FEATURE_LIGHTNING_PAYMENTS=true

# NOSTR protocol integration
FEATURE_NOSTR_PUBLISHING=true

# AI-powered content generation
FEATURE_AI_CONTENT_GENERATION=true

# Content monetization features
FEATURE_CONTENT_MONETIZATION=true

# Premium subscription system
FEATURE_PREMIUM_SUBSCRIPTIONS=true

# Real-time notifications
FEATURE_REALTIME_NOTIFICATIONS=true

# Advanced analytics
FEATURE_ADVANCED_ANALYTICS=true

# Multi-language support
FEATURE_INTERNATIONALIZATION=false

# ==========================================
# 📊 SHARED MONITORING CONFIGURATION
# ==========================================

# Logging configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics collection
METRICS_ENABLED=true
METRICS_INTERVAL=60000

# Error tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0

# ==========================================
# 🔒 SHARED RATE LIMITING CONFIGURATION
# ==========================================

# Redis configuration for rate limiting and caching
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL=3600
REDIS_MAX_CONNECTIONS=10

# Rate limiting settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# Lightning-specific rate limits
LIGHTNING_RATE_LIMIT_WINDOW_MS=60000
LIGHTNING_RATE_LIMIT_MAX_REQUESTS=10

# ==========================================
# 📧 SHARED EMAIL CONFIGURATION
# ==========================================

# Email service configuration
EMAIL_SERVICE=smtp
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME=Sovren Platform
EMAIL_SUPPORT=support@your-domain.com

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email templates
EMAIL_TEMPLATE_DIR=./templates/email
EMAIL_TEMPLATE_CACHE=true

# ==========================================
# 📁 SHARED FILE STORAGE CONFIGURATION
# ==========================================

# File storage settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,audio/mpeg

# IPFS configuration (optional)
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
IPFS_API_URL=https://api.pinata.cloud
PINATA_JWT_TOKEN=your-pinata-jwt-token

# Arweave configuration (optional)
ARWEAVE_GATEWAY_URL=https://arweave.net
ARWEAVE_WALLET_PATH=./arweave-wallet.json

# ==========================================
# 🤖 SHARED AI CONFIGURATION
# ==========================================

# OpenAI configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Anthropic configuration (alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# AI feature settings
AI_CONTENT_MAX_LENGTH=5000
AI_CONTENT_CACHE_TTL=3600

# ==========================================
# 🌐 SHARED CORS CONFIGURATION
# ==========================================

# CORS settings for API endpoints
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ==========================================
# 🔧 SHARED PERFORMANCE CONFIGURATION
# ==========================================

# Cache settings
CACHE_TTL=300
CACHE_MAX_SIZE=1000
CACHE_STRATEGY=lru

# Request timeout settings
REQUEST_TIMEOUT=30000
LONG_REQUEST_TIMEOUT=120000

# Compression settings
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6

# ==========================================
# 🧪 SHARED TESTING CONFIGURATION
# ==========================================

# Test database configuration
TEST_DATABASE_URL=postgresql://sovren:test_password@localhost:5432/sovren_test
TEST_REDIS_URL=redis://localhost:6380

# Test environment settings
TEST_TIMEOUT=30000
TEST_PARALLEL=true
TEST_VERBOSE=false

# Mock services for testing
MOCK_LIGHTNING_PAYMENTS=false
MOCK_NOSTR_RELAYS=false
MOCK_AI_SERVICES=false

# ==========================================
# 📋 CONFIGURATION VALIDATION RULES
# ==========================================

# Required variables (comma-separated)
REQUIRED_VARS=NODE_ENV,SUPABASE_URL,SUPABASE_ANON_KEY,JWT_SECRET,SESSION_SECRET

# Production-specific required variables
PRODUCTION_REQUIRED_VARS=SENTRY_DSN,LIGHTNING_WEBHOOK_SECRET,CORS_ORIGIN

# Secret minimum lengths (variable_name:min_length)
SECRET_MIN_LENGTHS=JWT_SECRET:32,SESSION_SECRET:32,ENCRYPTION_KEY:32

# URL validation patterns
URL_VARS=SUPABASE_URL,LNBITS_API_URL,SENTRY_DSN,REDIS_URL

# ==========================================
# 📚 USAGE INSTRUCTIONS
# ==========================================

# DEVELOPMENT SETUP:
# 1. Copy relevant variables to package-specific .env files
# 2. Backend: Copy database, auth, and API variables
# 3. Frontend: Copy public variables and client-side config
# 4. Shared: Used for type definitions and validation

# PRODUCTION CHECKLIST:
# □ All REQUIRED_VARS are set
# □ All PRODUCTION_REQUIRED_VARS are set
# □ Secrets meet minimum length requirements
# □ URLs are valid and accessible
# □ Feature flags are configured appropriately
# □ Rate limits are set for production load
# □ Monitoring and error tracking is configured

# SECURITY NOTES:
# - Never commit actual secrets to version control
# - Use different secrets for each environment
# - Rotate secrets regularly
# - Use strong, random secrets (32+ characters)
# - Validate all environment variables on startup
