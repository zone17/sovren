# Development Dockerfile for Sovren Frontend
# Optimized for development with Vite hot reloading

FROM node:20-alpine

# Install development tools
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    curl \
    git \
    && rm -rf /var/cache/apk/*

WORKDIR /app

# Copy package files for dependency installation
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm ci && npm cache clean --force

# Copy configuration files
COPY vite.config.ts ./
COPY tsconfig*.json ./
COPY tailwind.config.js ./
COPY postcss.config.js ./
COPY index.html ./

# Copy source code (this will be overridden by volume mounts)
COPY src/ ./src/
COPY public/ ./public/

# Create non-root user for development
RUN addgroup -g 1001 -S nodejs && \
    adduser -S frontend -u 1001 -G nodejs

# Set ownership of app directory
RUN chown -R frontend:nodejs /app

# Switch to non-root user
USER frontend

# Expose Vite dev server port
EXPOSE 5173

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5173/ || exit 1

# Development command with hot reloading
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# Metadata labels
LABEL org.opencontainers.image.title="Sovren Frontend Development"
LABEL org.opencontainers.image.description="Development environment for Sovren frontend"
LABEL org.opencontainers.image.version="dev"
