{
  "name": "Sovren Frontend Dependency Configuration",
  "version": "1.0.0",
  "description": "Comprehensive dependency management for analytics and UI components",
  "lastUpdated": "2024-12-30",

  "analytics": {
    "core": {
      "@tanstack/react-query": {
        "version": "^5.83.0",
        "required": true,
        "purpose": "Data fetching, caching, and synchronization for analytics",
        "compatibility": {
          "react": ">=18.0.0",
          "typescript": ">=5.0.0"
        },
        "devDependency": false,
        "securityLevel": "high",
        "testCoverage": true
      },
      "@tanstack/react-query-devtools": {
        "version": "^5.83.0",
        "required": false,
        "purpose": "Development tools for React Query debugging",
        "compatibility": {
          "@tanstack/react-query": "^5.83.0"
        },
        "devDependency": true,
        "securityLevel": "low",
        "testCoverage": false
      }
    },
    "ui": {
      "recharts": {
        "version": "^2.15.3",
        "required": true,
        "purpose": "Chart and data visualization components",
        "compatibility": {
          "react": ">=16.8.0",
          "react-dom": ">=16.8.0"
        },
        "devDependency": false,
        "securityLevel": "medium",
        "testCoverage": true
      },
      "date-fns": {
        "version": "^4.1.0",
        "required": true,
        "purpose": "Date manipulation and formatting utilities",
        "compatibility": {
          "typescript": ">=4.0.0"
        },
        "devDependency": false,
        "securityLevel": "low",
        "testCoverage": true
      },
      "lucide-react": {
        "version": "^0.513.0",
        "required": true,
        "purpose": "Icon components for analytics UI",
        "compatibility": {
          "react": ">=16.8.0"
        },
        "devDependency": false,
        "securityLevel": "low",
        "testCoverage": false
      }
    },
    "validation": {
      "zod": {
        "version": "^3.25.42",
        "required": true,
        "purpose": "Schema validation for analytics data",
        "compatibility": {
          "typescript": ">=4.0.0"
        },
        "devDependency": false,
        "securityLevel": "medium",
        "testCoverage": true
      }
    }
  },

  "uiComponents": {
    "radix": {
