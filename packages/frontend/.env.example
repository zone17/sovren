# Frontend Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env files with real credentials

# Database Connection (from Supabase dashboard)
DATABASE_URL="postgresql://user:password@host:port/database"

# CI/CD Dashboard Configuration
VITE_GITHUB_OWNER=your-github-username
VITE_GITHUB_REPO=your-repo-name
VITE_GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXX
VITE_STAGING_API_URL=http://localhost:3001
VITE_PRODUCTION_API_URL=https://api.your-domain.com
VITE_WEBSOCKET_URL=ws://localhost:3001/ws/deployments
VITE_SSE_URL=http://localhost:3001/sse/deployments

# Supabase Configuration (if needed)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Auth Configuration
# VITE_API_URL — backend API base URL (default: http://localhost:3001)
VITE_API_URL=http://localhost:3001
# VITE_ENABLE_BACKEND — set to true to use real backend (default: true)
VITE_ENABLE_BACKEND=true
# VITE_DEMO_MODE — set to true to use demo/mock auth, bypasses real backend
# VITE_DEMO_MODE=false