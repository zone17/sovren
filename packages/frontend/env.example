# 🌐 Sovren Frontend Environment Configuration
# Copy this file to .env.local (Next.js/Vite) or .env and update with your actual values
# All variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Variables without NEXT_PUBLIC_ are server-side only

# ==========================================
# 🚀 CORE APPLICATION SETTINGS
# ==========================================

# Environment type - affects build optimizations and debugging
# Values: development | production | test
NODE_ENV=development

# Vercel deployment environment (auto-populated by Vercel)
# Values: development | preview | production
VERCEL_ENV=development

# Vercel deployment URL (auto-populated by Vercel)
VERCEL_URL=

# ==========================================
# 🗄️ DATABASE & BACKEND CONFIGURATION (REQUIRED)
# ==========================================

# Supabase configuration - get from https://app.supabase.com/project/YOUR_PROJECT/settings/api
# Required for all database operations and authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API URL - points to your Sovren backend service
# Development: http://localhost:3001
# Production: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# ==========================================
# 🔐 AUTHENTICATION & SECURITY
# ==========================================

# NextAuth.js secret - required for JWT encryption
# Generate with: openssl rand -base64 32
# CRITICAL: Must be at least 32 characters in production
NEXTAUTH_SECRET=your-nextauth-secret-change-this-in-production

# NextAuth.js URL - your application's URL
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# JWT secret for custom JWT operations (optional)
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-for-custom-operations

# Encryption key for sensitive data (32 characters exactly)
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=your-32-character-encryption-key

# ==========================================
# ⚡ LIGHTNING NETWORK CONFIGURATION
# ==========================================

# Lightning Network settings exposed to browser for payment UI
# Network type: mainnet | testnet | regtest
NEXT_PUBLIC_LIGHTNING_NETWORK=testnet

# Minimum payment amount in satoshis (1000 = ~$0.30 at $30k BTC)
NEXT_PUBLIC_LIGHTNING_MIN_AMOUNT=1000

# Maximum payment amount in satoshis (100M = ~$30 at $30k BTC)
NEXT_PUBLIC_LIGHTNING_MAX_AMOUNT=100000000

# Lightning address domain for creator addresses
# Example: creator@your-domain.com
NEXT_PUBLIC_LIGHTNING_ADDRESS_DOMAIN=your-domain.com

# ==========================================
# 🌐 NOSTR PROTOCOL CONFIGURATION
# ==========================================

# NOSTR relay URLs (comma-separated) - exposed to browser for real-time features
# Use reliable public relays or your own relay
NEXT_PUBLIC_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social,wss://relay.current.fyi

# Auto-connect to NOSTR relays on app start
# Values: true | false
NEXT_PUBLIC_NOSTR_AUTO_CONNECT=true

# Connection timeout in milliseconds
NEXT_PUBLIC_NOSTR_CONNECTION_TIMEOUT=5000

# Maximum number of relays to connect to simultaneously
NEXT_PUBLIC_NOSTR_MAX_RELAYS=10

# Cache TTL for NOSTR events in milliseconds (5 minutes default)
NEXT_PUBLIC_NOSTR_CACHE_TTL=300000

# ==========================================
# 💳 PAYMENT PROCESSING (OPTIONAL)
# ==========================================

# Stripe configuration (if using traditional payments alongside Lightning)
# Get from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ==========================================
# 📧 EMAIL CONFIGURATION (SERVER-SIDE)
# ==========================================

# SMTP configuration for transactional emails
# Gmail example - use app passwords: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email addresses
FROM_EMAIL=noreply@your-domain.com
SUPPORT_EMAIL=support@your-domain.com

# ==========================================
# 📊 ANALYTICS & MONITORING
# ==========================================

# Google Analytics 4 configuration
# Get from https://analytics.google.com/
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Enable analytics data collection
# Values: true | false
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Performance monitoring
# Values: true | false
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# Sentry error tracking (optional)
# Get from https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ==========================================
# 🤖 AI SERVICES CONFIGURATION (OPTIONAL)
# ==========================================

# OpenAI API configuration for AI-powered features
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic Claude API (alternative to OpenAI)
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ==========================================
# 📁 FILE STORAGE CONFIGURATION (OPTIONAL)
# ==========================================

# AWS S3 configuration for file uploads
# Get from AWS IAM console
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# Maximum file upload size in bytes (10MB default)
NEXT_PUBLIC_MAX_FILE_SIZE=10485760

# ==========================================
# 🔒 SECURITY & RATE LIMITING
# ==========================================

# Redis URL for rate limiting and session storage
RATE_LIMIT_REDIS_URL=redis://localhost:6379

# Login attempt limits
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900

# ==========================================
# 🌐 CORS & NETWORKING
# ==========================================

# Allowed origins for CORS (comma-separated)
# Development: http://localhost:3000,http://localhost:3001
# Production: https://your-domain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Enable credentials in CORS requests
# Values: true | false
CORS_CREDENTIALS=true

# ==========================================
# 🚩 FEATURE FLAGS
# ==========================================

# Enable/disable major features
# Values: true | false

# Payment processing features
NEXT_PUBLIC_ENABLE_PAYMENTS=true

# AI-powered content features
NEXT_PUBLIC_ENABLE_AI_FEATURES=true

# Email notification system
ENABLE_EMAIL_NOTIFICATIONS=false

# File upload functionality
NEXT_PUBLIC_ENABLE_FILE_UPLOADS=true

# Lightning Network payments
NEXT_PUBLIC_ENABLE_LIGHTNING_PAYMENTS=true

# NOSTR protocol integration
NEXT_PUBLIC_ENABLE_NOSTR_FEATURES=true

# Premium subscription features
NEXT_PUBLIC_ENABLE_PREMIUM_SUBSCRIPTIONS=true

# Content monetization features
NEXT_PUBLIC_ENABLE_CONTENT_MONETIZATION=true

# ==========================================
# 🧪 DEVELOPMENT & DEBUGGING
# ==========================================

# Enable API documentation (development only)
# Values: true | false
ENABLE_API_DOCS=false

# Debug mode - enables verbose logging
# Values: true | false
DEBUG_MODE=false

# Log level for application logging
# Values: error | warn | info | debug
LOG_LEVEL=info

# ==========================================
# 📱 PWA CONFIGURATION (OPTIONAL)
# ==========================================

# PWA manifest configuration
NEXT_PUBLIC_APP_NAME=Sovren
NEXT_PUBLIC_APP_SHORT_NAME=Sovren
NEXT_PUBLIC_APP_DESCRIPTION=Creator Monetization Platform
NEXT_PUBLIC_THEME_COLOR=#000000

# ==========================================
# 🔧 BUILD & DEPLOYMENT
# ==========================================

# Bundle analyzer (set to true to analyze bundle size)
ANALYZE=false

# Source maps in production (security consideration)
GENERATE_SOURCEMAP=false

# ==========================================
# 📋 ENVIRONMENT-SPECIFIC NOTES
# ==========================================

# DEVELOPMENT SETUP:
# 1. Copy this file to .env.local
# 2. Set up Supabase project and add URL + keys
# 3. Configure NOSTR relays (use provided defaults)
# 4. Set NEXTAUTH_SECRET (generate with: openssl rand -base64 32)
# 5. Optional: Add OpenAI API key for AI features
# 6. Optional: Add Stripe keys for payment testing
# 7. Run: npm run dev

# PRODUCTION SETUP:
# 1. All REQUIRED variables must be set
# 2. Use strong secrets (64+ characters for sensitive keys)
# 3. Set proper CORS origins
# 4. Configure monitoring (Sentry, Analytics)
# 5. Set up proper email SMTP
# 6. Use environment variables in deployment platform
# 7. Test thoroughly in staging environment

# SECURITY CHECKLIST:
# □ All secrets are unique and strong
# □ No default/example values in production
# □ CORS origins are restrictive
# □ Rate limiting is configured
# □ HTTPS is enforced in production
# □ Sensitive variables are not NEXT_PUBLIC_
