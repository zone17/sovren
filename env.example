# Sovren Environment Configuration
# Copy this file to .env and configure with your actual values

# ===========================================
# CORE APPLICATION SETTINGS
# ===========================================

# Environment
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Domain and SSL (Production)
DOMAIN=your-domain.com
SSL_EMAIL=admin@your-domain.com

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================

# Supabase Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (if using local PostgreSQL instead of Supabase)
DATABASE_URL=postgresql://sovren:dev_password@localhost:5432/sovren_dev

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=7d

# Session Management
SESSION_SECRET=your-session-secret-change-this-in-production

# ===========================================
# LIGHTNING NETWORK CONFIGURATION
# ===========================================

# LNbits API Configuration
LNBITS_API_URL=https://your-lnbits-instance.com
LNBITS_ADMIN_KEY=your-lnbits-admin-key
LNBITS_INVOICE_READ_KEY=your-lnbits-invoice-read-key
LNBITS_WEBHOOK_SECRET=your-webhook-secret

# Lightning Network Settings
LIGHTNING_NETWORK=mainnet
LIGHTNING_MIN_AMOUNT=1000
LIGHTNING_MAX_AMOUNT=100000000

# ===========================================
# NOSTR PROTOCOL CONFIGURATION
# ===========================================

# NOSTR Relays (comma-separated websocket URLs)
# Used by backend services - configure your preferred NOSTR relays
# Default relays are used if not specified: relay.damus.io, nos.lol, relay.nostr.band, relay.snort.social, relay.current.fyi
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social,wss://relay.current.fyi

# NOSTR Relays for Frontend (Vite environment)
# Same format as NOSTR_RELAYS but prefixed with VITE_ for frontend access
# Falls back to NOSTR_RELAYS if not specified
VITE_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social,wss://relay.current.fyi

# NOSTR Settings
NOSTR_PRIVATE_KEY=your-nostr-private-key-hex
NOSTR_PUBLIC_KEY=your-nostr-public-key-hex

# ===========================================
# REDIS CONFIGURATION
# ===========================================

# Redis Connection
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=dev_redis_password_change_in_production
REDIS_TTL=3600

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

# SMTP Settings (for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# Email Templates
EMAIL_FROM_NAME=Sovren Platform
EMAIL_SUPPORT=support@your-domain.com

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================

# IPFS Configuration
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
IPFS_API_URL=https://api.pinata.cloud
PINATA_JWT_TOKEN=your-pinata-jwt-token

# Arweave Configuration
ARWEAVE_GATEWAY_URL=https://arweave.net
ARWEAVE_WALLET_PATH=./arweave-wallet.json

# Local Storage (development)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ===========================================
# AI & ANALYTICS CONFIGURATION
# ===========================================

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_SAMPLING_RATE=0.1

# ===========================================
# MONITORING & OBSERVABILITY
# ===========================================

# Sentry Error Tracking
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Grafana
GRAFANA_PASSWORD=admin_password_change_this

# Prometheus
PROMETHEUS_ENABLED=true

# ===========================================
# RATE LIMITING
# ===========================================

# API Rate Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# Lightning Rate Limits
LIGHTNING_RATE_LIMIT_WINDOW_MS=60000
LIGHTNING_RATE_LIMIT_MAX_REQUESTS=10

# ===========================================
# FEATURE FLAGS
# ===========================================

# Feature Toggles
FEATURE_LIGHTNING_PAYMENTS=true
FEATURE_AI_CONTENT_GENERATION=true
FEATURE_NOSTR_PUBLISHING=true
FEATURE_CONTENT_MONETIZATION=true
FEATURE_PREMIUM_SUBSCRIPTIONS=true

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================

# Debug Settings
DEBUG_ENABLED=true
DEBUG_NAMESPACE=sovren:*

# Hot Reload
HOT_RELOAD=true
WATCH_FILES=true

# Testing
TEST_DATABASE_URL=postgresql://sovren:test_password@localhost:5432/sovren_test
TEST_REDIS_URL=redis://localhost:6380

# ===========================================
# PRODUCTION SETTINGS
# ===========================================

# Performance
CLUSTER_MODE=false
WORKER_PROCESSES=auto
KEEP_ALIVE_TIMEOUT=65000

# Security
CORS_ORIGIN=https://your-domain.com
SECURE_COOKIES=true
HELMET_ENABLED=true

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ===========================================
# DOCKER SPECIFIC SETTINGS
# ===========================================

# Container Configuration
CONTAINER_MEMORY_LIMIT=1024m
CONTAINER_CPU_LIMIT=1.0

# Health Checks
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
