# ============================================================================
# Production Environment Configuration Example
# ============================================================================
# Copy this file to terraform.tfvars and fill in your actual values
# NEVER commit terraform.tfvars to version control!
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (SUPABASE PRODUCTION PROJECT)
# ============================================================================
database_url      = "postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"
database_host     = "db.[PROJECT-ID].supabase.co"
database_port     = 5432
database_username = "postgres"
database_password = "your-production-database-password-use-strong-password"

# ============================================================================
# REDIS CONFIGURATION (UPSTASH OR RAILWAY PRODUCTION)
# ============================================================================
redis_url      = "rediss://default:[PASSWORD]@production-redis.upstash.io:6379"  # Note: rediss:// for TLS
redis_password = "your-production-redis-password-use-strong-password"

# ============================================================================
# GITHUB CONFIGURATION
# ============================================================================
github_repository_owner = "your-github-username-or-org"

# ============================================================================
# PRODUCTION FEATURES
# ============================================================================
enable_debug_logging          = false  # IMPORTANT: Disable debug in production
enable_performance_monitoring = true
enable_error_tracking         = true
cdn_enabled                   = true

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
require_ssl      = true
secure_cookies   = true
helmet_enabled   = true
